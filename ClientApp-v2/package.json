{
  "name": "moonphim-ui-v2",
  "private": true,
  "description": "Tailwind build for the V2 UI (Views/V2/**). Output is committed to wwwroot/v2/css/v2.css so the Docker build needs no Node.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src/v2.css -o ../wwwroot/v2/css/v2.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i src/v2.css -o ../wwwroot/v2/css/v2.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "tailwindcss": "3.4.17"
  }
}
