        },
        "description": "Test 404 error response when movie doesn't exist"
      },
      "response": []
    },
    {
      "name": "Get Movie Detail - Invalid Slug Test",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/movie/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "movie", ""]
        },
        "description": "Test 400 error response for empty slug"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://moonphim.me",
