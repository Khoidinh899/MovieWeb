                        </div>
                    </div>
                }

                <div id="avatarMessageBox" class="mt-3" style="display: none;"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Lấy dữ liệu từ C# Model
            var isVerified = @Model.IsStudentVerified.ToString().ToLower();
            var verifiedDate = "@Model.StudentEmailVerifiedAt?.ToString("yyyy-MM-dd")";

            // Gọi hàm trong file profile.js và truyền dữ liệu C# vào
            checkStudentEmailStatus(isVerified, verifiedDate);
        });
    </script>
}