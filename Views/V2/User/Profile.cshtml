@model MovieWeb.Models.DTOs.UserProfileDto

@{
    ViewData["Title"] = "Tài khoản của tôi";
}

@section Styles {
    <link rel="stylesheet" href="~/v2/css/bootstrap-lite.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/v2/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/v2/css/notification.css" asp-append-version="true" />
    <style>
        .verification-step {
            animation: fadeIn 0.3s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        #otpCode {
            font-family: 'Courier New', monospace;
        }

    </style>
}

<div class="mx-auto w-full max-w-[1600px] px-margin-mobile pb-space-xl pt-space-lg md:px-margin">
    @Html.AntiForgeryToken()
    <nav class="mb-space-md flex items-center gap-space-xs font-body-sm text-body-sm text-on-surface-variant" aria-label="Breadcrumb">
        <a class="flex items-center gap-1 transition-colors hover:text-primary" href="/trang-chu"><span class="material-symbols-outlined text-[16px]">home</span> Trang Chủ</a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <span class="font-headline-sm text-headline-sm text-on-surface">Hồ sơ người dùng</span>
    </nav>

    <div class="grid grid-cols-1 gap-space-lg lg:grid-cols-[300px_minmax(0,1fr)]">
        @await Html.PartialAsync("Partial/_UserSidebarV2", (Model.Avatar, Model.FullName, Model.Username, Model.RoleName, Model.SubscriptionType, Model.IsAdmin))

        <div class="flex min-w-0 flex-col gap-space-lg">
            <div class="flex flex-wrap items-end justify-between gap-space-md">
                <div>
                    <h1 class="font-headline-xl-mobile text-headline-xl-mobile text-on-surface md:font-headline-xl md:text-headline-xl">Thông Tin Tài Khoản</h1>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Quản lý hồ sơ, gói dịch vụ và lịch sử xem phim của bạn.</p>
                </div>
                <a href="/user/edit" class="inline-flex items-center gap-space-xs px-space-lg py-space-sm font-label-md text-label-md font-bold v2-btn-3d v2-btn-3d--primary">
                    <span class="material-symbols-outlined text-[18px]">edit</span> Chỉnh sửa hồ sơ
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="flex items-center gap-space-sm rounded-xl bg-surface-container-high p-space-md text-on-surface" role="status">
                    <span class="material-symbols-outlined text-primary">check_circle</span> @TempData["SuccessMessage"]
                </div>
            }

            <div class="grid grid-cols-2 gap-space-md md:grid-cols-4">
                <a href="/user/history" class="rounded-xl bg-surface-container-low p-space-md transition-colors hover:bg-surface-container">
                    <div class="flex items-center justify-between font-label-sm text-label-sm uppercase text-on-surface-variant">Lịch sử xem <span class="material-symbols-outlined text-[20px] text-primary">history</span></div>
                    <p class="mt-space-xs font-headline-xl-mobile text-headline-xl-mobile text-on-surface">@Model.TotalWatchHistory</p>
                </a>
                <a href="/user/favorite" class="rounded-xl bg-surface-container-low p-space-md transition-colors hover:bg-surface-container">
                    <div class="flex items-center justify-between font-label-sm text-label-sm uppercase text-on-surface-variant">Yêu thích <span class="material-symbols-outlined text-[20px] text-error" style="font-variation-settings: 'FILL' 1;">favorite</span></div>
                    <p class="mt-space-xs font-headline-xl-mobile text-headline-xl-mobile text-on-surface">@Model.TotalFavorites</p>
                </a>
                <div class="rounded-xl bg-surface-container-low p-space-md">
                    <div class="flex items-center justify-between font-label-sm text-label-sm uppercase text-on-surface-variant">Bình luận <span class="material-symbols-outlined text-[20px] text-primary">chat</span></div>
                    <p class="mt-space-xs font-headline-xl-mobile text-headline-xl-mobile text-on-surface">@Model.TotalComments</p>
                </div>
                <div class="rounded-xl bg-surface-container-low p-space-md">
                    <div class="flex items-center justify-between font-label-sm text-label-sm uppercase text-on-surface-variant">Đánh giá <span class="material-symbols-outlined text-[20px] text-secondary" style="font-variation-settings: 'FILL' 1;">star</span></div>
                    <p class="mt-space-xs font-headline-xl-mobile text-headline-xl-mobile text-on-surface">@Model.TotalRatings</p>
                </div>
            </div>

            <section class="rounded-xl bg-surface-container-low p-space-lg shadow-sm" aria-labelledby="profile-details">
                <h2 id="profile-details" class="mb-space-md flex items-center gap-space-xs font-headline-md text-headline-md font-bold text-on-surface">
                    <span class="material-symbols-outlined text-primary">badge</span> Chi Tiết Hồ Sơ
                </h2>
                <dl class="grid grid-cols-1 gap-space-sm md:grid-cols-2">
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Họ và tên</dt>
                        <dd class="font-semibold text-on-surface">@Model.FullName</dd>
                    </div>
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Tên đăng nhập</dt>
                        <dd class="font-semibold text-on-surface">@Model.Username</dd>
                    </div>
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Email</dt>
                        <dd class="flex flex-wrap items-center gap-space-xs font-semibold text-on-surface">
                            @Model.Email
                            @if (Model.EmailConfirmed)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-surface-container-highest px-2 py-0.5 font-label-sm text-label-sm text-primary"><span class="material-symbols-outlined text-[14px]">verified</span> Đã xác thực</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-secondary-container px-2 py-0.5 font-label-sm text-label-sm text-on-secondary-container"><span class="material-symbols-outlined text-[14px]">error</span> Chưa xác thực</span>
                            }
                        </dd>
                    </div>
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Email sinh viên</dt>
                        <dd class="text-on-surface">
                            @if (Model.IsStudentVerified && !string.IsNullOrEmpty(Model.StudentEmail))
                            {
                                <div class="flex flex-wrap items-center gap-space-xs">
                                    <span class="font-semibold">@Model.StudentEmail</span>
                                    <span class="inline-flex items-center gap-1 rounded-full bg-surface-container-highest px-2 py-0.5 font-label-sm text-label-sm text-primary" id="studentVerifiedBadge"><span class="material-symbols-outlined text-[14px]">verified</span> Đã xác thực</span>
                                    @if (Model.StudentEmailVerificationExpiry.HasValue)
                                    {
                                        var daysLeft = (Model.StudentEmailVerificationExpiry.Value - DateTime.Now).Days;
                                        if (daysLeft <= 7 && daysLeft > 0)
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-secondary-container px-2 py-0.5 font-label-sm text-label-sm text-on-secondary-container" id="studentExpiringBadge">Sắp hết hạn</span>
                                        }
                                        else if (daysLeft <= 0)
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-error-container px-2 py-0.5 font-label-sm text-label-sm text-on-error-container" id="studentExpiredBadge">Hết hạn</span>
                                        }
                                    }
                                    <button type="button" class="ml-auto rounded-full bg-surface-container-high px-3 py-1 font-label-sm text-label-sm text-primary hover:bg-surface-variant" id="btnRenewStudent" style="display:none;" onclick="openRenewModal()">
                                        Gia hạn
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn-verify-student inline-flex items-center gap-1 rounded-full bg-primary-container px-space-md py-1.5 font-label-md text-label-md font-bold text-on-primary-container" onclick="openVerificationModal()">
                                    <span class="material-symbols-outlined text-[16px]">shield</span> Xác thực Email Sinh viên
                                </button>
                            }
                        </dd>
                    </div>
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Gói dịch vụ</dt>
                        <dd class="flex flex-col gap-1">
                            <div class="flex flex-wrap items-center gap-space-xs">
                                @if (Model.SubscriptionType == "premium")
                                {
                                    <span class="rounded-full bg-secondary px-space-sm py-0.5 font-label-sm text-label-sm font-bold text-on-secondary">MoonPro</span>
                                }
                                else if (Model.SubscriptionType == "student")
                                {
                                    <span class="rounded-full bg-primary px-space-sm py-0.5 font-label-sm text-label-sm font-bold text-on-primary">MoonStu</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-surface-container-highest px-space-sm py-0.5 font-label-sm text-label-sm font-bold text-secondary">Free</span>
                                }
                                @if (Model.IsCancelled)
                                {
                                    <span class="rounded-full bg-secondary-container px-2 py-0.5 font-label-sm text-label-sm text-on-secondary-container">Đã hủy gia hạn</span>
                                }
                            </div>
                            @if (Model.RemainingDaysFromPreviousPackage > 0)
                            {
                                <small class="font-label-sm text-label-sm italic text-primary">+ @Model.RemainingDaysFromPreviousPackage ngày từ gói trước</small>
                            }
                        </dd>
                    </div>
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Vai trò / Trạng thái</dt>
                        <dd class="flex flex-wrap items-center gap-space-xs">
                            <span class="rounded-full bg-surface-container-high px-space-sm py-0.5 font-label-sm text-label-sm text-on-surface">@Model.RoleName</span>
                            <span class="rounded-full px-space-sm py-0.5 font-label-sm text-label-sm @(Model.IsActive ? "bg-surface-container-highest text-primary" : "bg-error-container text-on-error-container")">@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</span>
                        </dd>
                    </div>
                    <div class="rounded-lg bg-surface-container p-space-sm">
                        <dt class="font-label-sm text-label-sm text-on-surface-variant">Ngày tham gia</dt>
                        <dd class="font-semibold text-on-surface">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    @if (Model.LastLogin.HasValue)
                    {
                        <div class="rounded-lg bg-surface-container p-space-sm">
                            <dt class="font-label-sm text-label-sm text-on-surface-variant">Đăng nhập lần cuối</dt>
                            <dd class="font-semibold text-on-surface">@Model.LastLogin.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                    }
                </dl>
            </section>

            <div class="flex flex-col items-start justify-between gap-space-md rounded-xl bg-gradient-to-br from-surface-container to-surface-container-high p-space-lg md:flex-row md:items-center">
                <div class="flex items-center gap-space-sm text-secondary">
                    <span class="material-symbols-outlined text-[28px]">verified</span>
                    <div>
                        <p class="font-headline-sm text-headline-sm font-bold">Xem phim miễn phí trên MoonPhim</p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Nâng cấp gói là tùy chọn để trải nghiệm tốt hơn, không bắt buộc để xem phim.</p>
                    </div>
                </div>
                <a href="/nang-cap" class="rounded-full bg-surface-container-highest px-space-lg py-space-sm font-label-md text-label-md font-bold text-secondary hover:bg-surface-variant">Xem các gói</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="studentVerificationModal" tabindex="-1" aria-labelledby="studentVerificationModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="studentVerificationModalLabel">
                    <i class="bi bi-mortarboard me-2"></i>Xác thực Email Sinh viên
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Lưu ý:</strong> Xác thực email sinh viên (.edu, .edu.vn, .ac.vn) để mở khóa gói
                    Student với
                    giá ưu đãi.
                    <br /><small>Email sinh viên có hiệu lực 12 tháng. Bạn sẽ nhận được thông báo trước 7 ngày
                        để gia
                        hạn.</small>
                </div>

                <div id="modalStep1" class="verification-step">
                    <div class="mb-3">
                        <label for="modalStudentEmail" class="form-label">
                            <i class="bi bi-envelope me-2"></i>Email sinh viên
                        </label>
                        <input type="email" class="form-control" id="modalStudentEmail"
                            placeholder="example@university.edu.vn" value="@Model.StudentEmail" />
                        <small class="form-text text-muted">
                            Chỉ chấp nhận email có đuôi .edu, .edu.vn, .ac.vn
                        </small>
                    </div>
                    <button type="button" class="btn btn-primary w-100" id="modalSendOtpBtn" onclick="sendOTP()">
                        <i class="bi bi-send me-2"></i>Gửi mã xác thực
                    </button>
                </div>

                <div id="modalStep2" class="verification-step" style="display: none;">
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle me-2"></i>
                        Mã xác thực đã được gửi đến email <strong id="modalSentEmailDisplay"></strong>
                    </div>

                    <div class="mb-3">
                        <label for="modalOtpCode" class="form-label">
                            <i class="bi bi-key me-2"></i>Mã OTP (6 chữ số)
                        </label>
                        <input type="text" class="form-control text-center" id="modalOtpCode" placeholder="000000"
                            maxlength="6" style="font-size: 24px; letter-spacing: 8px; font-weight: bold;" />
                        <small class="form-text text-muted">
                            Mã OTP có hiệu lực trong 5 phút
                        </small>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-success flex-fill" id="modalVerifyOtpBtn"
                            onclick="verifyOTP()">
                            <i class="bi bi-check-circle me-2"></i>Xác thực
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resendOTP()">
                            <i class="bi bi-arrow-clockwise me-2"></i>Gửi lại
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="cancelVerification()">
                            <i class="bi bi-x-circle me-2"></i>Hủy
                        </button>
                    </div>

                    <div id="modalOtpTimer">
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            Mã hết hạn sau: <span id="modalCountdown" class="fw-bold">05:00</span>
                        </small>
                    </div>
                </div>

                <div id="modalLoadingSpinner" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Đang xử lý...</p>
                </div>

                <div id="modalMessageBox" class="mt-3" style="display: none;"></div>
            </div>
        </div>
    </div>
</div>
<!-- Avatar Selection Modal -->
<div class="modal fade" id="avatarSelectionModal" tabindex="-1" aria-labelledby="avatarSelectionModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="avatarSelectionModalLabel">
                    <i class="bi bi-image me-2"></i>Chọn Avatar
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                @* Logic đã được cập nhật dựa trên User.cs model *@
                @if (Model.IsPremium)
                {
                    <ul class="nav nav-tabs" id="avatarTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="upload-tab" data-bs-toggle="tab"
                                data-bs-target="#uploadTabPane" type="button" role="tab" aria-controls="uploadTabPane"
                                aria-selected="true">
                                <i class="bi bi-upload me-1"></i> Tải ảnh lên
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="select-tab" data-bs-toggle="tab" data-bs-target="#selectTabPane"
                                type="button" role="tab" aria-controls="selectTabPane" aria-selected="false">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Chọn avatar có sẵn
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content" id="avatarTabContent">
                        <div class="tab-pane fade show active" id="uploadTabPane" role="tabpanel"
                            aria-labelledby="upload-tab" tabindex="0">
                            <div class="text-center p-4">
                                <img id="avatarPreview" src="/images/nouser.png" alt="Xem trước"
                                    class="img-thumbnail rounded-circle mb-3"
                                    style="width: 150px; height: 150px; object-fit: cover;">

                                <input type="file" class="form-control" id="avatarUploadInput" accept="image/*">

                                <button id="saveUploadAvatarBtn" class="btn btn-primary mt-3">
                                    <i class="bi bi-save me-1"></i> Lưu avatar này
                                </button>
                                <div id="uploadMessageBox" class="mt-3" style="display: none;"></div>
                            </div>
                        </div>

