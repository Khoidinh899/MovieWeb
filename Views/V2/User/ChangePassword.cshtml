@model MovieWeb.Models.DTOs.ChangePasswordDto

@{
    ViewData["Title"] = "Đổi mật khẩu";
    const string input = "w-full rounded-lg border-0 bg-surface-container px-space-md py-2.5 pr-12 text-on-surface placeholder:text-outline focus:ring-1 focus:ring-primary";
    const string label = "mb-1 block font-label-md text-label-md text-on-surface-variant";
    const string eye = "pw-toggle absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full text-on-surface-variant hover:text-on-surface";
}

@section Styles {
    <link rel="stylesheet" href="~/v2/css/bootstrap-lite.css" asp-append-version="true" />
}

<div class="u2-shell mx-auto w-full max-w-[1600px] px-margin-mobile pb-space-xl pt-space-lg md:px-margin">
    <nav class="mb-space-md flex items-center gap-space-xs font-body-sm text-body-sm text-on-surface-variant" aria-label="Breadcrumb">
        <a class="flex items-center gap-1 transition-colors hover:text-primary" href="/trang-chu"><span class="material-symbols-outlined text-[16px]">home</span> Trang Chủ</a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <a class="transition-colors hover:text-primary" href="/user/profile">Tài Khoản</a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <span class="font-headline-sm text-headline-sm text-on-surface">Đổi Mật Khẩu</span>
    </nav>

    <div class="grid grid-cols-1 gap-space-lg lg:grid-cols-[300px_minmax(0,1fr)]">
        <div>
            @{ var __sb = (MovieWeb.Models.DTOs.UserProfileDto)ViewBag.UserProfile; }
            @await Html.PartialAsync("Partial/_UserSidebarV2", (__sb.Avatar, __sb.FullName, __sb.Username, __sb.RoleName, __sb.SubscriptionType, __sb.IsAdmin))
        </div>

        <div class="u2-content min-w-0">
            <div class="mb-space-lg">
                <p class="font-label-sm text-label-sm font-bold uppercase tracking-widest text-secondary">Cài đặt &amp; bảo mật</p>
                <h1 class="font-headline-xl-mobile text-headline-xl-mobile text-on-surface md:font-headline-xl md:text-headline-xl">Đổi Mật Khẩu</h1>
            </div>

            <section class="max-w-3xl rounded-xl bg-surface-container-low p-space-lg shadow-sm" aria-labelledby="pw-title">
                <div class="mb-space-lg flex items-center gap-space-sm">
                    <span class="material-symbols-outlined flex h-11 w-11 items-center justify-center rounded-full bg-surface-container-high text-[22px] text-secondary">password</span>
                    <div>
                        <h2 id="pw-title" class="font-headline-md text-headline-md font-bold text-on-surface">Đổi Mật Khẩu Đăng Nhập</h2>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Khuyến nghị thay đổi định kỳ để bảo vệ tài khoản khỏi xâm nhập trái phép.</p>
                    </div>
                </div>

                <form asp-action="ChangePassword" method="post" class="change-password-form flex flex-col gap-space-md">
                    <div asp-validation-summary="ModelOnly" class="rounded-lg bg-error-container p-space-sm text-on-error-container empty:hidden"></div>

                    <div>
                        <label asp-for="CurrentPassword" class="@label">Mật khẩu hiện tại</label>
                        <div class="relative">
                            <input asp-for="CurrentPassword" type="password" class="@input" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                            <button type="button" class="@eye" aria-label="Hiện/ẩn mật khẩu"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="mt-1 block font-label-sm text-label-sm text-error"></span>
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="@label">Mật khẩu mới</label>
                        <div class="relative">
                            <input asp-for="NewPassword" type="password" class="@input" placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                            <button type="button" class="@eye" aria-label="Hiện/ẩn mật khẩu"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="mt-1 block font-label-sm text-label-sm text-error"></span>
                        <div class="mt-space-xs flex items-center justify-between font-label-sm text-label-sm text-on-surface-variant">
                            <span>Độ mạnh mật khẩu:</span><span id="pwStrengthLabel" class="font-bold">—</span>
                        </div>
                        <div class="mt-1 grid grid-cols-4 gap-1" aria-hidden="true">
                            <span class="pw-bar h-1.5 rounded-full bg-surface-container-highest"></span><span class="pw-bar h-1.5 rounded-full bg-surface-container-highest"></span>
                            <span class="pw-bar h-1.5 rounded-full bg-surface-container-highest"></span><span class="pw-bar h-1.5 rounded-full bg-surface-container-highest"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="@label">Xác nhận mật khẩu mới</label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" type="password" class="@input" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            <button type="button" class="@eye" aria-label="Hiện/ẩn mật khẩu"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="mt-1 block font-label-sm text-label-sm text-error"></span>
                    </div>

                    <div class="rounded-lg bg-surface-container p-space-md">
                        <p class="mb-space-xs font-label-md text-label-md font-bold text-on-surface">Tiêu chí bảo mật gợi ý:</p>
                        <ul class="grid grid-cols-1 gap-1 font-label-md text-label-md text-on-surface-variant sm:grid-cols-2">
                            <li data-rule="len" class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">radio_button_unchecked</span> Tối thiểu 8 ký tự</li>
                            <li data-rule="upper" class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">radio_button_unchecked</span> Có ít nhất 1 chữ hoa (A-Z)</li>
                            <li data-rule="digit" class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">radio_button_unchecked</span> Có ít nhất 1 số (0-9)</li>
                            <li data-rule="special" class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">radio_button_unchecked</span> Có ký tự đặc biệt (!@@#$%)</li>
                        </ul>
                    </div>

                    <div class="flex flex-wrap justify-end gap-space-sm">
                        <a asp-action="Profile" class="inline-flex items-center gap-1 rounded-full bg-surface-container-high px-space-lg py-space-sm font-label-md text-label-md text-on-surface hover:bg-surface-variant">Quay lại</a>
                        <button type="submit" class="inline-flex items-center gap-1 px-space-lg py-space-sm font-label-md text-label-md font-bold v2-btn-3d v2-btn-3d--primary">
                            <span class="material-symbols-outlined text-[18px]">lock_reset</span> Cập Nhật Mật Khẩu
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Gợi ý độ mạnh mật khẩu (chỉ hiển thị, không thay thế kiểm tra phía server)
        (function () {
            var pw = document.getElementById('NewPassword');
            var bars = document.querySelectorAll('.pw-bar');
            var label = document.getElementById('pwStrengthLabel');
            var rules = { len: function (v) { return v.length >= 8; }, upper: function (v) { return /[A-Z]/.test(v); }, digit: function (v) { return /\d/.test(v); }, special: function (v) { return /[^A-Za-z0-9]/.test(v); } };
            var names = ['—', 'Yếu', 'Trung bình', 'Mạnh', 'Rất mạnh'];
            var colors = ['', 'bg-error', 'bg-secondary', 'bg-primary', 'bg-primary-container'];
            function update() {
                var v = pw ? pw.value : '', score = 0;
                Object.keys(rules).forEach(function (k) {
                    var ok = rules[k](v); if (ok) score++;
                    var li = document.querySelector('[data-rule="' + k + '"]'); if (!li) return;
                    li.classList.toggle('text-primary', ok);
                    li.firstElementChild.textContent = ok ? 'check_circle' : 'radio_button_unchecked';
                });
                if (!v) score = 0;
                bars.forEach(function (b, i) {
                    b.className = 'pw-bar h-1.5 rounded-full ' + (i < score ? colors[score] : 'bg-surface-container-highest');
                });
                if (label) label.textContent = names[score];
            }
            if (pw) pw.addEventListener('input', update);
            document.querySelectorAll('.pw-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = btn.parentElement.querySelector('input');
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.firstElementChild.textContent = show ? 'visibility_off' : 'visibility';
                });
            });
            update();
        })();
    </script>
}
