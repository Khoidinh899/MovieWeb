@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache MemoryCache
@{
    // ===== ✅ BẮT ĐẦU KHỐI CHUẨN BỊ BIẾN SEO MẶC ĐỊNH =====
    var request = Context.Request;
    var baseUrl = MovieWeb.Helpers.SeoMetadata.BaseUrl;
    var defaultSeoImage = $"{baseUrl}/images/iconmoon.png";

    // ===== IP RATE LIMITING CHO QUẢNG CÁO ONCLICK (24H) =====
    var clientIp = Context.Request.Headers["X-Forwarded-For"].FirstOrDefault() 
                   ?? Context.Connection.RemoteIpAddress?.ToString() 
                   ?? "unknown";
    if (clientIp.Contains(",")) {
        clientIp = clientIp.Split(',')[0].Trim();
    }
    var ipCacheKey = $"monetag_pop_{clientIp}";
    var hasSeenPopunder = MemoryCache.TryGetValue(ipCacheKey, out _) 
                          || Context.Request.Cookies.ContainsKey("moonphim_pop_done");
}
<!DOCTYPE html>
<html lang="vi" class="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="monetag" content="1bd43555dd0c57f4ee0258b218db6891">

    <!-- Web App & PWA iOS Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MoonPhim" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="MoonPhim" />
    <meta name="theme-color" content="#0a0e27" />

    <!-- Google AdSense Auto Ads Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8229451063311920"
            crossorigin="anonymous"></script>


    @{
        var seoPageTitle = ViewData["SeoTitle"] as string ?? ViewData["Title"]?.ToString() ?? "MoonPhim";
        if (!seoPageTitle.Contains("MoonPhim", StringComparison.OrdinalIgnoreCase)) seoPageTitle += " | MoonPhim";
    }
    <title>@seoPageTitle</title>
    <link rel="canonical" href="@MovieWeb.Helpers.SeoMetadata.Canonical(Context.Request)" />
    @if (MovieWeb.Helpers.SeoMetadata.NoIndex(Context.Request))
    {
        <meta name="robots" content="noindex, follow" />
    }

    <!-- Schema.org WebSite & Brand Organization Markup (MoonPhim / Moon Phim) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "MoonPhim",
      "alternateName": ["Moon Phim", "MoonPhim.me", "Moon Phim Online", "MoonPhim HD"],
      "url": "https://moonphim.me/",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "https://moonphim.me/tim-kiem?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <!-- Resource Preconnect & DNS-Prefetch for Fast Asset Loading -->
    <link rel="preconnect" href="https://vsmov.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com">

    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" asp-append-version="true">
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true">
    <link rel="manifest" href="~/manifest.json" asp-append-version="true">
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true">

    @* ===== V2 STYLES (Tailwind build: ClientApp-v2 -> wwwroot/v2/css/v2.css). Không nạp Bootstrap/CSS V1. ===== *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/v2/css/v2.css" asp-append-version="true" />
    @* Mobile tab bar keeps the V1 design: reuse its V1 stylesheet + Bootstrap Icons (as in V1) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/mobile-bottom-nav.css" asp-append-version="true" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/v2/css/chatbot-v2.css" asp-append-version="true" />
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <link rel="stylesheet" href="~/v2/css/notification.css" asp-append-version="true" />
    }

    @* --- BẮT ĐẦU KHỐI SEO MẶC ĐỊNH --- *@
    <meta name="keywords" content="moonphim, moon phim, moonphim me, moon phim online, phimmoi, phim moi, rophim, ro phim, cobephim, co be phim, motphim, mot phim, motchill, phimmoichill, xem phim online, phim vietsub, phim thuyet minh, xem phim mien phi, bay bong cung dien anh" />
    <meta name="theme-color" content="#1c2a39" />
    <meta name="author" content="MoonPhim (Moon Phim)" />

    <meta property="og:site_name" content="MoonPhim" />
    <meta property="og:image" content="@defaultSeoImage" />
    <meta property="og:locale" content="vi_VN" />
    @* --- KẾT THÚC KHỐI SEO MẶC ĐỊNH --- *@

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="v2 bg-background text-on-background font-body antialiased @(ViewData["IsHomePage"] as bool? == true ? "home-page" : "")"
    data-is-premium="@(ViewBag.IsPremium ?? false).ToString().ToLower()"
    data-is-series-type="@(ViewBag.IsSeriesType ?? false).ToString().ToLower()"
    data-user-logged-in="@User.Identity.IsAuthenticated.ToString().ToLower()">

    @{
        var token = antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" value="@token" />

    @* ===== DO NOT EDIT ABOVE: head SEO/ads + token are copied verbatim from Views/Shared/_Layout.cshtml ===== *@
    <script>document.documentElement.classList.add('v2-js');</script>
    @await Html.PartialAsync("Partial/_HeaderV2")

    <main role="main" id="v2-main">
        @RenderBody()
    </main>
    @await Html.PartialAsync("Partial/_ImgRevealV2")
    <script>window.MoonPhimV2ImgInit && window.MoonPhimV2ImgInit();</script>

    @await Html.PartialAsync("Partial/_FooterV2")
    @* Nút lên đầu trang (như V1): hiện sau khi cuộn > 200px, logic trong ~/v2/js/header-v2.js *@
    <button type="button" id="scrollTopBtn" aria-label="Lên đầu trang" class="v2-scroll-top v2-btn-3d v2-btn-3d--primary v2-btn-3d--icon" hidden>
        <span class="material-symbols-outlined">arrow_upward</span>
    </button>
    @await Html.PartialAsync("Partial/_MobileBottomNavV2")

    @* Bootstrap JS only (no Bootstrap CSS): keeps V1 scripts working; state classes styled in ClientApp-v2/src/v2.css *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/v2/js/v2.js" asp-append-version="true"></script>
    <script src="~/v2/js/mobile-nav-v2.js" asp-append-version="true"></script>
    <script src="~/v2/js/search-suggest-v2.js" asp-append-version="true"></script>
    <script src="~/v2/js/header-v2.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
        <script src="~/js/notification.js" asp-append-version="true"></script>
        @await Html.PartialAsync("Partial/_ChatbotV2")
        <script src="~/js/chatbot.js" asp-append-version="true"></script>
    }
    @* Add V1 scripts here as their markup is ported (same ids): auth.js, search.js, notification.js, chatbot.js... *@
    @await RenderSectionAsync("Scripts", required: false)

    @await Html.PartialAsync("Partial/_AnnouncementModalV2")

    @* ===== DO NOT EDIT BELOW: Monetag scripts copied verbatim from Views/Shared/_Layout.cshtml ===== *@
    <!-- Monetag Vignette (Chạy trên cả Web và App qua Idle Callback) -->
    <script>
        (function () {
            if (window.moonphimVignetteInitialized) return;
            window.moonphimVignetteInitialized = true;
            var loadMonetag = function () {
                if (document.querySelector('script[data-zone="11708850"]')) return;
                // Nạp Vignette (Zone 11708850)
                var vig = document.createElement('script');
                vig.dataset.zone = '11708850';
                vig.src = 'https://n6wxm.com/vignette.min.js';
                document.body.appendChild(vig);
            };

            if (document.readyState === 'complete') {
                setTimeout(loadMonetag, 800);
            } else {
                window.addEventListener('load', function () {
                    if ('requestIdleCallback' in window) {
                        requestIdleCallback(loadMonetag, { timeout: 1500 });
                    } else {
                        setTimeout(loadMonetag, 800);
                    }
                });
            }
        })();
    </script>

    @if (!hasSeenPopunder)
    {
        <!-- Monetag OnClick (Popunder) Ads Script - Chạy trên cả Mobile & Desktop - Tần suất: 2 tiếng / lần -->
        <script>
            (function () {
                const STORAGE_KEY = 'moonphim_pop_done';
                const COOLDOWN = 2 * 60 * 60 * 1000;
                const ZONE_ID = '11708858';

                const isAppContext = () => {
                    const userAgent = navigator.userAgent || '';
                    const isInstalledPwa = navigator.standalone === true ||
                        window.matchMedia?.('(display-mode: standalone)').matches === true ||
                        window.matchMedia?.('(display-mode: minimal-ui)').matches === true;
                    const isAndroidWebView = /Android/i.test(userAgent) && /\bwv\b/i.test(userAgent);
                    const isNativeApp = /\bMoonPhimApp\b/i.test(userAgent) ||
                        (document.referrer || '').startsWith('android-app://');
                    return isInstalledPwa || isAndroidWebView || isNativeApp;
                };

                // Disable website OnClick in installed apps; ordinary browser tabs keep it.
                if (isAppContext()) return;
                // Shared across SPA replays; a per-initializer flag cannot prevent duplicates.
                const state = window.moonphimOnclickState ||= { pending: false, loaded: false };

                const isCoolingDown = () => {
                    const hasCookie = document.cookie.split(';').some(cookie =>
                        cookie.trim().startsWith(STORAGE_KEY + '='));
                    if (hasCookie) return true;
                    try {
                        const lastLoaded = Number(localStorage.getItem(STORAGE_KEY));
                        return Number.isFinite(lastLoaded) && lastLoaded > 0 &&
                            Date.now() - lastLoaded < COOLDOWN;
                    } catch {
                        return false; // Safari storage restrictions: rely on the cookie/global state.
                    }
                };

                if (state.pending || state.loaded ||
                    document.querySelector('script[data-zone="' + ZONE_ID + '"]') || isCoolingDown()) {
                    return;
                }

                const triggerPopunder = () => {
                    window.removeEventListener('click', triggerPopunder);
                    state.pending = false;
                    // Another tab can start cooldown after this listener was registered.
                    if (isAppContext() || state.loaded || isCoolingDown()) return;
                    state.loaded = true;

                    try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
                    document.cookie = STORAGE_KEY + '=1; max-age=7200; path=/; samesite=lax';

                    if (navigator.sendBeacon) {
                        navigator.sendBeacon('/api/ads/record-popunder');
                    } else {
                        fetch('/api/ads/record-popunder', { method: 'POST', keepalive: true }).catch(() => {});
                    }

                    const script = document.createElement('script');
                    script.dataset.zone = ZONE_ID;
                    script.src = 'https://al5sm.com/tag.min.js';
                    (document.body || document.documentElement).appendChild(script);
                };

                state.pending = true;
                window.addEventListener('click', triggerPopunder, { once: true, passive: true });
            })();
        </script>
    }
</body>

</html>
