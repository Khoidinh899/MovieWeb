@model List<MovieWeb.Models.Entities.Movie>
@using MovieWeb.Models.ViewModels

@{
    var categoryName = ViewBag.CategoryName as string ?? "Phim lẻ";
    var filters = ViewBag.Filters as MovieFilterViewModel ?? new MovieFilterViewModel();
    var currentUrl = MovieWeb.Helpers.SeoMetadata.Canonical(Context.Request);
    var seoTitle = $"{categoryName} - Xem phim {categoryName} mới nhất | MoonPhim";
    var seoDesc = ViewBag.SeoDescription as string ?? $"Xem {categoryName} mới nhất, chất lượng cao, vietsub + thuyết minh. Cập nhật liên tục tại MoonPhim.";
    var seoImage = "https://moonphim.me/images/moonphim-logo.jpg";
}

@section Styles {
    <meta name="description" content="@seoDesc" />
    <meta property="og:title" content="@seoTitle" />
    <meta property="og:description" content="@seoDesc" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:image" content="@seoImage" />
    <meta property="og:site_name" content="MoonPhim" />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@seoDesc" />
    <meta name="twitter:image" content="@seoImage" />
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [{
            "@@type": "ListItem",
            "position": 1,
            "name": "Trang chủ",
            "item": "@(Context.Request.Scheme)://@(Context.Request.Host)/"
        },{
            "@@type": "ListItem",
            "position": 2,
            "name": "@categoryName"
        }]
    }
    </script>
}

@await Html.PartialAsync("Partial/_MovieListV2", (categoryName, Model, filters, (int)(ViewBag.CurrentPage ?? 1), (int)(ViewBag.TotalPages ?? 1), "Popup_PhimLe"))
