@model List<MovieWeb.Models.Entities.Movie>
@using MovieWeb.Models.ViewModels
@using MovieWeb.Models.Entities

@{
    var category = ViewBag.Category as Category;
    var categoryName = category?.Name ?? "Thể loại";
    var filters = ViewBag.Filters as MovieFilterViewModel ?? new MovieFilterViewModel();
}

@section Styles {
    <meta name="description" content="@(ViewBag.SeoDescription as string ?? $"Khám phá phim { categoryName } trên MoonPhim theo năm phát hành và danh sách tập cập nhật.")" />
}

@await Html.PartialAsync("Partial/_MovieListV2", ($"Thể loại: {categoryName}", Model, filters, (int)(ViewBag.CurrentPage ?? 1), (int)(ViewBag.TotalPages ?? 1), "Popup_TheLoai"))
