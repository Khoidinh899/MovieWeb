@model MovieWeb.Models.DTOs.ForgotPasswordDto
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Quên mật khẩu - MoonPhim";
}

<div class="mx-auto flex min-h-[70vh] w-full max-w-5xl items-center px-margin-mobile py-10 md:px-margin">
    <div class="flex w-full flex-col overflow-hidden rounded-xl border border-outline-variant/30 bg-surface-container/70 shadow-2xl backdrop-blur-2xl lg:flex-row">
        @await Html.PartialAsync("Partial/_AuthAsideV2")

        <div class="p-6 md:p-10 lg:w-1/2">
            <h2 class="font-headline-lg text-2xl font-bold text-on-surface">Quên mật khẩu</h2>
            <p class="mb-6 mt-1 font-body-sm text-on-surface-variant">Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu.</p>

            <div id="authAlert" class="mb-4 hidden rounded-lg px-4 py-3 text-sm" role="alert"></div>

            <form id="forgotPasswordFormSubmit" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label for="forgotEmail" class="mb-1 block font-label-md text-on-surface">Email</label>
                    <input type="email" id="forgotEmail" name="Email" required placeholder="example@gmail.com"
                           class="w-full rounded-lg border border-outline-variant/60 bg-surface-container-low px-4 py-2.5 text-on-surface placeholder:text-outline focus:border-primary focus:outline-none" />
                </div>
                <div id="turnstile-container" data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
                <button type="submit" id="forgotSubmit" class="w-full py-3 font-headline-sm font-bold disabled:opacity-60 v2-btn-3d v2-btn-3d--primary">
                    <span id="forgotBtnText">Gửi link đặt lại</span>
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-on-surface-variant">
                <a href="/Auth/Login" class="font-bold text-primary hover:text-secondary">← Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/v2/js/pages/auth.js" asp-append-version="true"></script>
}
