@{
    ViewData["Title"] = "Giới thiệu - MoonPhim";
    (string Icon, string Title, string Text)[] reasons =
    {
        ("movie", "Kho phim khổng lồ", "Cập nhật liên tục những bộ phim bom tấn, phim bộ hot nhất từ Hollywood, Hàn Quốc, Trung Quốc và Việt Nam."),
        ("high_quality", "Chất lượng đỉnh cao", "Trải nghiệm hình ảnh Full HD 1080p sắc nét cùng âm thanh sống động."),
        ("speed", "Tốc độ vượt trội", "Hệ thống server mạnh mẽ, đảm bảo xem phim mượt mà, không giật lag ngay cả với kết nối mạng trung bình."),
        ("devices", "Giao diện hiện đại", "Thiết kế tối giản, tinh tế và cực kỳ dễ sử dụng trên cả máy tính và điện thoại."),
        ("auto_awesome", "Cá nhân hóa", "Tính năng yêu thích, lịch sử xem và gợi ý phim thông minh bằng AI."),
    };
}

<div class="mx-auto w-full max-w-[1600px] px-margin-mobile pb-space-xl pt-space-lg md:px-margin">
    <nav class="mb-space-md flex items-center gap-space-xs font-body-sm text-body-sm text-on-surface-variant" aria-label="Breadcrumb">
        <a class="flex items-center gap-1 transition-colors hover:text-primary" href="/trang-chu"><span class="material-symbols-outlined text-[16px]">home</span> Trang Chủ</a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <span class="font-headline-sm text-headline-sm text-secondary">Giới Thiệu</span>
    </nav>

    <section class="rounded-xl bg-gradient-to-br from-surface-container to-surface-container-low p-space-lg shadow-xl md:p-space-xl">
        <div class="mb-space-sm inline-flex items-center gap-space-xs rounded-full bg-surface-container-high px-space-sm py-1">
            <span class="h-2 w-2 rounded-full bg-secondary"></span>
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">Xem phim miễn phí</span>
        </div>
        <h1 class="font-display-hero-mobile text-display-hero-mobile tracking-tight text-on-surface md:font-display-hero md:text-display-hero">Chào mừng đến với <span class="text-primary">MoonPhim</span></h1>
        <p class="mt-space-sm max-w-3xl font-body-lg text-body-lg text-on-surface-variant">“Bay bổng cùng điện ảnh - Chạm tới những ước mơ cùng MoonPhim.”</p>
    </section>

    <nav class="my-space-lg grid grid-cols-2 gap-space-xs rounded-xl bg-surface-container-low p-space-xs md:grid-cols-4" aria-label="Thông tin & trợ giúp">
        <a href="/about" aria-current="page" class="flex items-center justify-center gap-space-xs rounded-full bg-primary-container px-space-md py-space-sm font-label-md text-label-md font-bold text-on-primary-container"><span class="material-symbols-outlined text-[18px]">info</span> Về MoonPhim</a>
        <a href="/contact" class="flex items-center justify-center gap-space-xs rounded-lg px-space-md py-space-sm font-label-md text-label-md text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface"><span class="material-symbols-outlined text-[18px]">support_agent</span> Liên hệ</a>
        <a href="/privacy" class="flex items-center justify-center gap-space-xs rounded-lg px-space-md py-space-sm font-label-md text-label-md text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface"><span class="material-symbols-outlined text-[18px]">lock</span> Quyền riêng tư</a>
        <a href="/dmca" class="flex items-center justify-center gap-space-xs rounded-lg px-space-md py-space-sm font-label-md text-label-md text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface"><span class="material-symbols-outlined text-[18px]">gavel</span> DMCA</a>
    </nav>

    <section class="mb-space-xl grid grid-cols-1 items-center gap-space-lg md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div>
            <p class="mb-1 flex items-center gap-1 font-label-sm text-label-sm font-bold uppercase tracking-widest text-primary"><span class="material-symbols-outlined text-[16px]">rocket_launch</span> Sứ mệnh của chúng tôi</p>
            <p class="font-body-lg text-body-lg leading-relaxed text-on-surface-variant">
                Tại <strong class="text-on-surface">MoonPhim</strong>, chúng tôi tin rằng điện ảnh không chỉ là giải trí, mà còn là những chuyến phiêu lưu kỳ diệu đưa bạn đến những thế giới mới. Sứ mệnh của chúng tôi là mang đến cho cộng đồng yêu phim Việt Nam một nền tảng xem phim chất lượng cao, mượt mà và hoàn toàn miễn phí.
            </p>
        </div>
        <div class="flex justify-center rounded-xl bg-surface-container-low p-space-lg">
            <img src="~/images/iconmoon.png" alt="MoonPhim Logo" class="h-32 w-auto drop-shadow-[0_0_20px_rgba(170,199,255,0.4)]" />
        </div>
    </section>

    <section class="mb-space-xl">
        <p class="mb-1 font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Giá trị cốt lõi</p>
        <h2 class="mb-space-md font-headline-lg text-headline-lg font-bold text-on-surface md:font-headline-xl md:text-headline-xl">Tại sao chọn MoonPhim?</h2>
        <div class="grid grid-cols-1 gap-space-md sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var r in reasons)
            {
                <div class="rounded-xl bg-surface-container-low p-space-lg transition-colors hover:bg-surface-container">
                    <span class="material-symbols-outlined mb-space-sm flex h-10 w-10 items-center justify-center rounded-lg bg-surface-container-high text-[22px] text-primary">@r.Icon</span>
                    <h3 class="mb-space-xs font-headline-sm text-headline-sm font-bold text-on-surface">@r.Title</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">@r.Text</p>
                </div>
            }
            <div class="rounded-xl bg-gradient-to-br from-surface-container to-surface-container-high p-space-lg">
                <span class="material-symbols-outlined mb-space-sm flex h-10 w-10 items-center justify-center rounded-lg bg-surface-container-highest text-[22px] text-secondary">volunteer_activism</span>
                <h3 class="mb-space-xs font-headline-sm text-headline-sm font-bold text-secondary">Cam kết cộng đồng</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Chúng tôi luôn lắng nghe ý kiến đóng góp từ người dùng để không ngừng cải thiện dịch vụ. MoonPhim cam kết xây dựng một môi trường xem phim sạch, an toàn và tôn trọng trải nghiệm của người xem.</p>
            </div>
        </div>
    </section>

    <section class="flex flex-col items-start justify-between gap-space-md rounded-xl bg-surface-container-low p-space-lg md:flex-row md:items-center">
        <div class="flex items-center gap-space-sm">
            <span class="material-symbols-outlined flex h-12 w-12 items-center justify-center rounded-lg bg-surface-container text-[26px] text-secondary">favorite</span>
            <div>
                <p class="font-headline-md text-headline-md font-bold text-on-surface">Ủng hộ MoonPhim</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Chia sẻ trang web đến bạn bè và người thân để MoonPhim đến được với nhiều người yêu phim hơn.</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-space-sm">
            <button type="button" id="aboutShare" class="inline-flex items-center gap-1 rounded-full bg-surface-container-high px-space-lg py-space-sm font-label-md text-label-md text-on-surface hover:bg-surface-variant"><span class="material-symbols-outlined text-[18px]">share</span> Chia Sẻ Nhanh</button>
            <a href="/trang-chu" class="inline-flex items-center gap-1 px-space-lg py-space-sm font-label-md text-label-md font-bold v2-btn-3d v2-btn-3d--primary"><span class="material-symbols-outlined text-[18px]">explore</span> Khám Phá Thêm</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById('aboutShare')?.addEventListener('click', async function () {
            var data = { title: document.title, url: location.origin };
            try {
                if (navigator.share) await navigator.share(data);
                else if (navigator.clipboard) { await navigator.clipboard.writeText(data.url); this.lastChild.textContent = ' Đã sao chép'; }
            } catch (e) { }
        });
    </script>
}
