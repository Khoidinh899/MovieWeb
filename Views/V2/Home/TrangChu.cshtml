    <meta name="description" content="@seoDescription" />
    <meta name="keywords"
          content="xem phim, xem phim online, phim hay, phim mới, moonphim, phim vietsub, phim thuyết minh, phim bộ, phim lẻ" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@seoUrl" />
    <meta property="og:image" content="@seoImage" />
    <meta property="og:site_name" content="MoonPhim" />
}

@section Scripts {
    <script src="~/v2/js/pages/home.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const shouldShowAds = @Json.Serialize(ViewBag.ShouldShowAds ?? true);

            // Hàm gọi API để lấy quảng cáo Pop-up
            async function fetchPopupAd() {
                if (!shouldShowAds) {
                    return;
                }
                try {
                    const response = await fetch('/api/ads/get-placements?placements=HomePage_Popup');

                    if (!response.ok) {
                        console.error('Lỗi API (Popup Ad):', response.statusText);
                        return;
                    }

                    const banners = await response.json();

                    if (banners && banners.length > 0) {
                        const banner = banners[0];

                        const modalHtml = createAdModalHtml(banner);

                        document.body.insertAdjacentHTML('beforeend', modalHtml);

                        var adModalElement = document.getElementById('homeAdModal');
                        if (adModalElement) {
                            var adModal = new bootstrap.Modal(adModalElement);
                            adModal.show();

                            adModalElement.addEventListener('hidden.bs.modal', function () {
                                adModalElement.remove();
                            });
                        }
                    }
                } catch (error) {
                    console.error('Lỗi khi tải popup ad:', error);
                }
            }

            function createAdModalHtml(banner) {
                let closeButtonCss = `
                position: absolute;
                top: -15px;
                right: -10px;
                background-color: white;
                border-radius: 50%;
                opacity: 1;
                box-shadow: 0 0 10px rgba(0,0,0,0.5);
                width: 30px;
                height: 30px;
                padding: 0;
            `;
                return `
            <div class="modal fade" id="homeAdModal" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="background-color: transparent; border: none;">
                  <div class="modal-body" style="padding: 0; position: relative;">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close" style="${closeButtonCss}"></button>
                    <a href="${banner.clickUrl}" target="_blank" rel="noopener noreferrer">
                        <img src="${banner.adContentUrl}" class="img-fluid rounded" alt="${banner.adName}">
                    </a>
                  </div>
                </div>
              </div>
            </div>`;
            }

            fetchPopupAd();

            // ===== TOP 10 TRENDING: KÉO NGANG VÔ TẬN (logic V1) =====
            const track = document.getElementById('top10Track');

            if (track) {
                let isDown = false;
                let startX = 0;
                let scrollStart = 0;
                let hasMoved = false;
                let cycleWidth = 0;
                let isAdjusting = false;

                // Đo khoảng cách chính xác giữa 2 chu kỳ (item 0 và item 10)
                function measureCycleWidth() {
                    const items = track.querySelectorAll('.top10-item');
                    if (items.length >= 11) {
                        cycleWidth = items[10].offsetLeft - items[0].offsetLeft;
                    }
                }

                // Cuộn về giữa (Cycle 1 / Cycle 2)
                function initInitialScroll() {
                    measureCycleWidth();
                    if (cycleWidth > 0) {
                        track.scrollLeft = cycleWidth * 1.5;
                    }
                }

                // Sự kiện cuộn vô tận mượt mà
                track.addEventListener('scroll', function () {
                    if (!isAdjusting && cycleWidth > 0) {
                        if (track.scrollLeft >= cycleWidth * 2.5) {
                            isAdjusting = true;
                            track.scrollLeft -= cycleWidth;
                            isAdjusting = false;
                        } else if (track.scrollLeft <= cycleWidth * 0.5) {
                            isAdjusting = true;
                            track.scrollLeft += cycleWidth;
                            isAdjusting = false;
                        }
                    }
                }, { passive: true });

                // Chuột kéo (Mouse Drag trên Desktop)
                track.addEventListener('mousedown', function (e) {
                    isDown = true;
                    hasMoved = false;
                    startX = e.pageX;
                    scrollStart = track.scrollLeft;
                });

                window.addEventListener('mouseup', function () {
                    if (!isDown) return;
                    isDown = false;
                    track.classList.remove('is-dragging');
                    if (hasMoved) {
                        setTimeout(() => { hasMoved = false; }, 200);
                    }
                });

                track.addEventListener('mousemove', function (e) {
                    if (!isDown) return;
                    const delta = e.pageX - startX;
                    if (Math.abs(delta) > 5) {
                        hasMoved = true;
                        track.classList.add('is-dragging');
                        e.preventDefault();
                        track.scrollLeft = scrollStart - (delta * 1.25);
                    }
                });

                // Chặn mở link nếu người dùng đang kéo chuột
                track.querySelectorAll('.top10-link').forEach(link => {
                    link.addEventListener('click', function (e) {
                        if (hasMoved) {
                            e.preventDefault();
                            e.stopPropagation();
                            return false;
                        }
                    }, true);
                });

                // Khởi tạo vị trí ban đầu
                setTimeout(initInitialScroll, 80);
                window.addEventListener('resize', measureCycleWidth);
            }
        });
    </script>
}
