@using MovieWeb.Helpers
@using MovieWeb.Models.Entities;
@model MovieWeb.Models.Entities.HomeViewModel
@{
    ViewData["Title"] = "MoonPhim - Xem Phim Online, Phim Mới, Phim Hay Miễn Phí";
    ViewData["IsHomePage"] = true; //gắn cờ đánh dấu đây là trang chủ

    // 1. Chuẩn bị Mô tả (Description)
    var seoDescription = "Khám phá phim mới trên MoonPhim: phim bộ, phim lẻ và hoạt hình. Tìm theo tên phim, thể loại, quốc gia và năm phát hành; theo dõi danh sách tập cập nhật.";

    // 2. Chuẩn bị Ảnh (Image) - Lấy ảnh phim hot đầu tiên
    var seoImage = "/images/mooner_logo_large.png"; // Dùng ảnh logo làm dự phòng
    if (Model.HotMovies.Any())
    {
        seoImage = GetHeroUrl(Model.HotMovies.First()); // og:image ngang như V1 (PosterUrl)
    }

    // 3. Chuẩn bị URL (Tự động lấy URL hiện tại)
    var request = Context.Request;
    var seoUrl = SeoMetadata.Canonical(request);

    var heroMovies = Model.HotMovies.Take(5).ToList();
    var top10List = (Model.TrendingMovies ?? new List<Movie>()).Take(10).ToList();
    var homePageBanners = (ViewBag.Advertisements as List<Advertisement> ?? new List<Advertisement>())
        .Where(a => a.Placement == "HomePage" && a.IsActive)
        .OrderBy(a => a.DisplayOrder)
        .ToList();
    bool shouldShowAds = ViewBag.ShouldShowAds ?? true;
}
@functions {
    // Banner: ảnh NGANG (VSMov poster_url). Thẻ phim: ảnh DỌC (VSMov thumb_url). Xem ImageHelper.
    public string GetHeroUrl(MovieWeb.Models.Entities.Movie movie)
        => ImageHelper.Landscape(movie.PosterUrl, movie.ThumbUrl, movie.Backdrop);

    public string GetMoviePosterUrl(MovieWeb.Models.Entities.Movie movie)
        => ImageHelper.Portrait(movie.ThumbUrl, movie.PosterUrl);


    public string FormatViews(int? views)
    {
        int v = views ?? 0;
        if (v >= 1000000)
            return (v / 1000000.0).ToString("0.#") + "M";
        if (v >= 1000)
            return (v / 1000.0).ToString("0.#") + "K";
        return v.ToString();
    }

    // Màu badge chất lượng (V1 dùng badge-success/primary/...; V2 dùng token màu)
    public string QualityClass(string? quality) => quality?.ToLower() switch
    {
        "hd" => "bg-surface-container-highest text-on-surface",
        "full hd" => "bg-primary-container text-white",
        "4k" => "bg-secondary text-on-secondary",
        "cam" => "bg-outline text-background",
        _ => "bg-surface-container-high text-on-surface-variant"
    };

    // Trạng thái tập của phim bộ (cùng logic V1)
    public string SeriesStatus(Movie movie)
    {
        var epDisplay = movie.EpisodeCurrent ?? "";
        if (epDisplay.Contains("Hoàn tất", StringComparison.OrdinalIgnoreCase) ||
            epDisplay.Contains("Hoàn Tất", StringComparison.OrdinalIgnoreCase) ||
            epDisplay.Contains("Full", StringComparison.OrdinalIgnoreCase) ||
            epDisplay.Contains("/", StringComparison.OrdinalIgnoreCase))
        {
            return epDisplay;
        }
        var totalStr = !string.IsNullOrEmpty(movie.EpisodeTotal) ? $"/{movie.EpisodeTotal}" : "";
        return epDisplay + totalStr;
    }
}

@* ===== HERO: slider toàn màn hình (thiết kế Stitch). Điều khiển bằng wwwroot/v2/js/pages/home.js ===== *@
@if (heroMovies.Any())
{
    @* Banner phủ kín một màn hình khi mới vào (chủ dự án yêu cầu), dùng ảnh NGANG (VSMov poster_url):
       >=992px: cao 100vh như V1, ảnh nền object-cover; ảnh nhỏ bên phải hiện đủ ảnh (object-contain).
       768-991px: cao = màn hình trừ header.
       <768px: cao = màn hình trừ header và tab bar (85px như mobile-bottom-nav.css); ảnh 16:9 hiện đủ ở trên, chữ ở dưới.
       Các slide xếp chồng bằng grid (cùng ô). *@
    <section id="heroSlider" class="relative w-full overflow-hidden bg-background max-lg:mt-[var(--v2-header-h,72px)]" aria-roledescription="carousel" aria-label="Phim nổi bật">
        <div class="relative grid w-full min-h-[calc(100svh-var(--v2-header-h,72px)-85px-env(safe-area-inset-bottom,0px))] md:min-h-[calc(100svh-var(--v2-header-h,72px))] lg:h-screen lg:min-h-[600px]">
            @for (int i = 0; i < heroMovies.Count; i++)
            {
                var hero = heroMovies[i];
                var bgUrl = GetHeroUrl(hero);
                <div class="home-hero-slide relative col-start-1 row-start-1 flex flex-col md:flex-row md:items-center" aria-hidden="@(i == 0 ? "false" : "true")">
                    <div class="relative aspect-video w-full shrink-0 overflow-hidden md:absolute md:inset-0 md:aspect-auto md:h-full">
                        <img src="@ImageHelper.Webp(bgUrl, 1280)" alt="" class="absolute inset-0 h-full w-full object-cover object-center opacity-60 saturate-[.8]" decoding="async"
                             onerror="this.onerror=null; this.src='/images/default-poster.jpg';" />
                        <div class="absolute inset-0 hidden bg-gradient-to-r from-background/95 via-background/60 to-background/10 md:block"></div>
                        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-background to-transparent md:h-40"></div>
                    </div>
                    <div class="relative z-20 mx-auto grid w-full max-md:flex-1 max-md:content-center max-w-[1600px] grid-cols-1 items-center gap-8 px-margin-mobile pb-20 pt-2 md:grid-cols-[minmax(0,1fr)_auto] md:px-margin md:pb-20 md:pt-10 lg:pt-32">
                        <div class="home-hero-text max-w-3xl space-y-3 max-md:text-center md:space-y-4">
                            <div class="flex flex-wrap items-center gap-2 text-[12px] font-bold max-md:justify-center">
                                <span class="rounded-full bg-secondary px-3 py-1 text-on-secondary">XEM MIỄN PHÍ</span>
                                @if (!string.IsNullOrEmpty(hero.Quality))
                                {
                                    <span class="rounded-full bg-surface-container-high/90 px-2.5 py-1 text-primary">@hero.Quality</span>
                                }
                                @if (!string.IsNullOrEmpty(hero.Language))
                                {
                                    <span class="rounded-full bg-surface-container-high/90 px-2.5 py-1 text-secondary">@hero.Language</span>
                                }
                            </div>
                            <h1 class="font-display-hero-mobile text-display-hero-mobile font-extrabold tracking-tight text-white drop-shadow-2xl md:font-display-hero md:text-display-hero">@hero.Name</h1>
                            @if (!string.IsNullOrEmpty(hero.OriginalName))
                            {
                                <p class="font-label-md text-sm text-primary">@hero.OriginalName</p>
                            }
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-on-surface-variant max-md:justify-center">
                                <span class="rounded-lg bg-surface-container-high/70 px-2.5 py-1 text-white">@hero.Year</span>
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">visibility</span>
                                    @((hero.ViewCount ?? 0).ToString("N0")) lượt xem
                                </span>
                            </div>
                            <p class="line-clamp-3 max-w-2xl font-body-md text-base leading-relaxed text-on-surface-variant/90 max-md:mx-auto">
                                @MovieHelper.GetDescription(hero.Content)
                            </p>
                            <div class="flex flex-wrap items-center gap-3 pt-2 max-md:justify-center">
                                <a href="/phim/@hero.Slug" class="v2-btn-3d v2-btn-3d--primary gap-2.5 px-7 py-3.5 font-headline-sm text-base font-bold">
                                    <span class="material-symbols-outlined text-[24px]">play_arrow</span> Xem Ngay
                                </a>
                                <a href="/phim/@hero.Slug" class="v2-btn-3d v2-btn-3d--glass gap-2 px-6 py-3.5 font-label-md text-sm">
                                    <span class="material-symbols-outlined text-[20px]">info</span> Chi Tiết
                                </a>
                            </div>
                        </div>
                        <a href="/phim/@hero.Slug" class="hidden justify-self-center md:block" tabindex="-1" aria-hidden="true">
                            <span class="v2-glass-frame block w-[300px] p-2 transition-transform duration-300 hover:-translate-y-2 hover:scale-[1.03] md:w-[340px] lg:w-[520px] xl:w-[640px] 2xl:w-[760px]">
                                <span class="relative block aspect-video overflow-hidden rounded-[18px] bg-surface-container-lowest">
                                    <img src="@ImageHelper.Webp(GetHeroUrl(hero), 200)" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-125 object-cover blur-xl brightness-75" decoding="async" />
                                    <img src="@ImageHelper.Webp(GetHeroUrl(hero), 800)" alt="@hero.Name" decoding="async" class="relative h-full w-full object-contain"
                                         onerror="this.onerror=null; this.src='/images/default-poster.jpg';" />
                                </span>
                            </span>
                        </a>
                    </div>
                </div>
            }

            <div class="absolute bottom-4 left-0 right-0 z-30 flex items-center justify-between gap-4 px-margin-mobile md:px-margin">
                <div class="flex min-w-0 items-center gap-2 overflow-x-auto">
                    @for (int i = 0; i < heroMovies.Count; i++)
                    {
                        <button type="button" data-slide-to="@i" aria-label="Phim nổi bật @(i + 1)"
                                class="max-w-[200px] shrink-0 truncate rounded-full bg-surface-container-high/80 px-3 py-1.5 font-label-sm text-label-sm text-on-surface-variant transition-colors hover:text-on-surface [&.is-active]:bg-primary-container [&.is-active]:text-on-primary-container">@(i + 1). @heroMovies[i].Name</button>
                    }
                </div>
                <div class="flex shrink-0 items-center gap-3">
                    <span id="heroCounter" class="font-label-sm text-xs text-outline">1 / @heroMovies.Count</span>
                    <button type="button" data-slide-prev aria-label="Phim trước" class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-container-high/80 text-white hover:bg-surface-container-highest">
                        <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                    </button>
                    <button type="button" data-slide-next aria-label="Phim sau" class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-container-high/80 text-white hover:bg-surface-container-highest">
                        <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>
    </section>
}

@* ===== QUẢNG CÁO BANNER TRANG CHỦ (logic V1) ===== *@
@if (shouldShowAds && homePageBanners.Any())
{
    <section class="mx-auto mb-5 mt-8 w-full max-w-[1600px] px-margin-mobile text-center md:px-margin">
        @foreach (var ad in homePageBanners)
        {
            <div class="ad-item mb-3" data-ad-id="@ad.AdId">
                <a href="@ad.ClickUrl" target="_blank" rel="noopener noreferrer" class="ad-link">
                    <img src="@ad.AdContentUrl" alt="@ad.AdName" class="mx-auto h-auto max-w-full rounded-lg" loading="lazy" />
                </a>
            </div>
        }
    </section>
}

@* ----- Top 10 trending: băng kéo ngang vô tận (id/class giữ nguyên để script bên dưới hoạt động) ----- *@
@if (top10List.Any())
{
    <section id="phim-trending" class="top10-neon-section mx-auto mb-5 w-full max-w-[1600px] px-margin-mobile md:px-margin">
        <div class="mb-6 flex items-end justify-between">
            <div>
                <p class="mb-1 flex items-center gap-2 font-label-sm text-xs font-bold uppercase tracking-widest text-secondary">
                    <span class="material-symbols-outlined text-[20px]">local_fire_department</span> Xu Hướng Xem Nhiều
                </p>
                <h2 class="font-headline-xl text-2xl font-bold tracking-tight text-white lg:text-3xl">Phim Trending</h2>
            </div>
            <a href="/phim-trending" class="flex items-center gap-1 font-label-md text-sm text-primary transition-colors hover:text-secondary">
                Xem tất cả <span class="material-symbols-outlined text-[18px]">chevron_right</span>
            </a>
        </div>

        <div class="top10-slider-wrapper relative" id="top10Wrapper">
            <div class="top10-track flex" id="top10Track" data-v2-img-group>
                @* Render 4 chu kỳ lặp (Cycle 0..3) để chuyển đổi 10 -> 1 -> 2 mượt mà không giật (logic V1) *@
                @for (int cycle = 0; cycle < 4; cycle++)
                {
                    for (int i = 0; i < top10List.Count; i++)
                    {
                        var movie = top10List[i];
                        var posterUrl = GetMoviePosterUrl(movie);
                        int rank = i + 1;
                        string rankStrokeClass = rank == 1 ? "rank-neon-gold" : rank == 2 ? "rank-neon-silver" : rank == 3 ? "rank-neon-bronze" : "rank-neon-blue";

                        var isSeries = movie.Type == "series" || (!string.IsNullOrEmpty(movie.EpisodeTotal) && movie.EpisodeTotal != "1");
                        string statusBadge = "";
                        if (!isSeries)
                        {
                            statusBadge = !string.IsNullOrEmpty(movie.Time) ? movie.Time : "Full";
                        }
                        else
                        {
                            var epCurrent = movie.EpisodeCurrent ?? "";
                            if (epCurrent.Contains("Hoàn tất", StringComparison.OrdinalIgnoreCase) ||
                                epCurrent.Contains("Hoàn Tất", StringComparison.OrdinalIgnoreCase) ||
                                epCurrent.Contains("Full", StringComparison.OrdinalIgnoreCase) ||
                                epCurrent.Contains("/", StringComparison.OrdinalIgnoreCase))
                            {
                                statusBadge = epCurrent;
                            }
                            else
                            {
                                var totalStr = !string.IsNullOrEmpty(movie.EpisodeTotal) ? $"/{movie.EpisodeTotal}" : "";
                                statusBadge = string.IsNullOrEmpty(epCurrent) ? (totalStr.TrimStart('/')) : (epCurrent + totalStr);
                                if (string.IsNullOrEmpty(statusBadge)) statusBadge = "Đang cập nhật";
                            }
                        }

                        <div class="top10-item" data-cycle="@cycle" data-index="@i">
                            <a href="/phim/@movie.Slug" class="top10-link block no-underline">
                                <div class="top10-card">
                                    <div class="top10-rank-number @rankStrokeClass">@rank</div>

                                    <div class="top10-poster-box relative aspect-[2/3] overflow-hidden rounded-xl border border-outline-variant/40 bg-surface-container shadow-[0_10px_25px_rgba(0,0,0,0.6)] transition-all duration-300">
                                        <img src="@ImageHelper.Webp(posterUrl, 400)" srcset="@ImageHelper.WebpSrcSet(posterUrl, 200, 400)" sizes="(min-width: 768px) 220px, 70vw" alt="@movie.Name" class="top10-img v2-img" loading="lazy"
                                             onerror="this.onerror=null; this.src='/images/default-poster.jpg';">

                                        <div class="absolute left-2 top-2 z-[6] flex items-center gap-1 rounded-md bg-background/75 px-2 py-0.5 text-[11px] font-bold text-secondary backdrop-blur">
                                            <span class="material-symbols-outlined text-[14px]">visibility</span>@FormatViews(movie.ViewCount)
                                        </div>

                                        @if (!string.IsNullOrEmpty(movie.Quality))
                                        {
                                            <div class="absolute right-2 top-2 z-[6] rounded bg-error/85 px-1.5 py-0.5 text-[11px] font-extrabold text-white">
                                                @movie.Quality
                                            </div>
                                        }

                                        <div class="top10-overlay absolute inset-0 flex items-center justify-center bg-background/40">
                                            <div class="top10-play-btn flex h-11 w-11 items-center justify-center rounded-full bg-secondary text-on-secondary shadow-[0_0_20px_rgba(245,196,81,0.6)]">
                                                <span class="material-symbols-outlined">play_arrow</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="top10-info mt-2">
                                        <h3 class="top10-title mb-1 truncate font-semibold text-on-surface" title="@movie.Name">@movie.Name</h3>
                                        <div class="flex items-center justify-between text-xs text-outline">
                                            <span>@(movie.Year?.ToString() ?? "2026")</span>
                                            <span class="rounded bg-surface-container-high px-1.5 py-0.5 text-on-surface-variant">@statusBadge</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}

