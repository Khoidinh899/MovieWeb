@model List<MovieWeb.Models.Entities.Movie>
@using MovieWeb.Models.ViewModels

@{
    Layout = "_Layout";
    var categoryName = "Phim Hoạt Hình";
    var filters = ViewBag.Filters as MovieFilterViewModel ?? new MovieFilterViewModel();
    
    // ===== BẮT ĐẦU KHỐI SEO =====
    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}";
    var currentUrl = $"{baseUrl}{request.Path}{request.QueryString}";
    var defaultSeoImage = $"{baseUrl}/images/iconmoon.png";
    
    // Tạo title động
    var pageTitle = "Phim Hoạt Hình Hay | Anime, Cartoon Mới Nhất";
    var seoDescription = ViewBag.SeoDescription as string ?? "Xem phim hoạt hình, anime, cartoon online miễn phí chất lượng cao, cập nhật liên tục tại MoonPhim.";
    
    ViewData["Title"] = pageTitle;
    // ===== KẾT THÚC KHỐI SEO =====
}

@* ===== META TAGS SEO ===== *@
<meta name="description" content="@seoDescription" />
<meta name="keywords" content="phim hoạt hình, anime, cartoon, hoạt hình vietsub, anime vietsub" />

@* Open Graph cho Facebook *@
<meta property="og:type" content="website" />
<meta property="og:title" content="@pageTitle" />
<meta property="og:description" content="@seoDescription" />
<meta property="og:url" content="@currentUrl" />
<meta property="og:image" content="@defaultSeoImage" />
<meta property="og:site_name" content="MoonPhim" />
<meta property="og:locale" content="vi_VN" />

@* Twitter Card *@
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@pageTitle" />
<meta name="twitter:description" content="@seoDescription" />
<meta name="twitter:image" content="@defaultSeoImage" />
<meta name="twitter:site" content="@("@")MoonPhim" />

@* Canonical URL *@
<link rel="canonical" href="@currentUrl" />

@functions {
    private string GetPosterUrl(MovieWeb.Models.Entities.Movie m)
    {
        var candidate = !string.IsNullOrEmpty(m.ThumbUrl) ? m.ThumbUrl : m.PosterUrl;

        if (string.IsNullOrEmpty(candidate))
            return Url.Content("~/images/no-image.jpg");

        candidate = candidate.Trim();

        if (candidate.StartsWith("http") || candidate.StartsWith("//"))
            return candidate;

        if (candidate.StartsWith("/"))
            return candidate;

        if (candidate.IndexOf("uploads", System.StringComparison.OrdinalIgnoreCase) >= 0)
            return candidate.StartsWith("/") ? candidate : "/" + candidate;

        var fallbackBase = "https://img.ophim.live/uploads/movies/";
        return fallbackBase + candidate;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/filter-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phimbo.css" asp-append-version="true" />

    @* ===== BREADCRUMB SCHEMA ===== *@
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [{
            "@@type": "ListItem",
            "position": 1,
            "name": "Trang chủ",
            "item": "@(Context.Request.Scheme)://@(Context.Request.Host)/"
        },{
            "@@type": "ListItem",
            "position": 2,
            "name": "Phim Hoạt Hình"
        }]
    }
    </script>
}

<section class="container py-4">
    <h2 class="text-white mb-4">
        <i class="fas fa-dragon text-warning"></i> @categoryName
    </h2>

    @* ===== RENDER BỘ LỌC ===== *@
    @await Html.PartialAsync("_FilterSidebar", filters)

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center mt-4">
            Không tìm thấy phim nào phù hợp.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var movie in Model)
            {
                var imgUrl = GetPosterUrl(movie);

                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <div class="movie-card position-relative overflow-hidden rounded shadow-sm">
                        <a href="/phim/@movie.Slug" class="text-decoration-none text-white">
                            <img src="@imgUrl"
                                 alt="@movie.Name"
                                 class="img-fluid w-100"
                                 style="aspect-ratio: 2/3; object-fit: cover;"
                                 onerror="this.src='@Url.Content("~/images/no-image.jpg")'" />
                            <div class="p-2">
                                <h6 class="text-truncate mb-0">@movie.Name</h6>
                                <small class="text-muted">@movie.EpisodeCurrent</small>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>

        @* ===== PHÂN TRANG ===== *@
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center flex-wrap"> @* Thêm flex-wrap để ko bị tràn màn hình *@
                    @{
                        var currentFilters = new Dictionary<string, string>();
                        // Giữ nguyên bộ lọc
                        if (!string.IsNullOrEmpty(filters.Type)) currentFilters["Type"] = filters.Type;
                        if (!string.IsNullOrEmpty(filters.Countries)) currentFilters["Countries"] = filters.Countries;
                        if (!string.IsNullOrEmpty(filters.Categories)) currentFilters["Categories"] = filters.Categories;
                        if (!string.IsNullOrEmpty(filters.Language)) currentFilters["Language"] = filters.Language;
                        if (!string.IsNullOrEmpty(filters.Years)) currentFilters["Years"] = filters.Years;
                        if (!string.IsNullOrEmpty(filters.SortBy)) currentFilters["SortBy"] = filters.SortBy;

                        string GetUrl(int page)
                        {
                            var queryParams = string.Join("&", currentFilters.Select(kvp => $"{kvp.Key}={System.Net.WebUtility.UrlEncode(kvp.Value)}"));
                            return $"?Page={page}" + (string.IsNullOrEmpty(queryParams) ? "" : "&" + queryParams);
                        }

                        int currentPage = ViewBag.CurrentPage;
                        int totalPages = (int)ViewBag.TotalPages;
                        // Quy định hiển thị: Trang đầu, trang cuối, và +- 2 trang quanh trang hiện tại
                        int range = 2; 
                    }

                    @* Nút Quay lại (Prev) *@
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@GetUrl(currentPage - 1)">&laquo;</a>
                        </li>
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        // Logic: Luôn hiện trang 1, trang cuối, hoặc trang đang chọn +- range
                        if (i == 1 || i == totalPages || (i >= currentPage - range && i <= currentPage + range))
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@GetUrl(i)">@i</a>
                            </li>
                        }
                        // Logic: Hiện dấu ... nếu khoảng cách quá xa
                        else if (i == currentPage - range - 1 || i == currentPage + range + 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @* Nút Tiếp theo (Next) *@
                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@GetUrl(currentPage + 1)">&raquo;</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</section>

<style>
    .movie-card img {
        transition: opacity .25s ease;
    }
    .movie-card:hover img {
        opacity: .85;
    }
</style>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetchPopupAd("Popup_HoatHinh");

        async function fetchPopupAd(placementName) {
            try {
                const response = await fetch(`/api/ads/get-placements?placements=${placementName}`);

                if (!response.ok) {
                    console.error(`Lỗi API (${placementName}):`, response.statusText);
                    return;
                }

                const banners = await response.json();
                if (banners && banners.length > 0) {
                    const banner = banners[0];
                    const modalId = `adModal_${placementName}`;
                    const modalHtml = createAdModalHtml(banner, modalId);

                    document.body.insertAdjacentHTML('beforeend', modalHtml);

                    var adModalElement = document.getElementById(modalId);
                    if (adModalElement) {
                        var adModal = new bootstrap.Modal(adModalElement);
                        adModal.show();

                        adModalElement.addEventListener('hidden.bs.modal', function () {
                            adModalElement.remove();
                        });
                    }
                }
            } catch (error) {
                console.error(`Lỗi khi tải popup ad (${placementName}):`, error);
            }
        }

        function createAdModalHtml(banner, modalId) {
            let closeButtonCss = `
                position: absolute;
                top: -15px;
                right: -10px;
                background-color: white;
                border-radius: 50%;
                opacity: 1;
                box-shadow: 0 0 10px rgba(0,0,0,0.5);
                width: 30px;
                height: 30px;
                padding: 0;
            `;

            return `
                <div class="modal fade" id="${modalId}" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content" style="background-color: transparent; border: none;">
                      <div class="modal-body" style="padding: 0; position: relative;">
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                                style="${closeButtonCss}"></button>
                        <a href="${banner.clickUrl}" target="_blank" rel="noopener noreferrer">
                            <img src="${banner.adContentUrl}" class="img-fluid rounded" alt="${banner.adName}">
                        </a>
                      </div>
                    </div>
                  </div>
                </div>`;
        }
    });
</script>
}