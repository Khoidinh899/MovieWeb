@model MovieWeb.Models.DTOs.UserProfileDto

@{
    ViewData["Title"] = "Tài khoản của tôi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <style>
        .navbar-custom {
            position: fixed !important;
            background: rgba(0, 0, 0, 0.95) !important;
            backdrop-filter: blur(10px);
        }
        body {
            padding-top: 80px;
        }
    </style>
}


<div class="container py-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card profile-sidebar">
                <div class="card-body text-center">
                    <div class="avatar-container mb-3">
                        <img src="@(Model.Avatar ?? "/images/default-avatar.png")" 
                             alt="Avatar" 
                             class="profile-avatar"
                             id="profileAvatar">
                        <div class="avatar-overlay">
                            <label for="avatarUpload" class="avatar-edit-btn">
                                <i class="bi bi-camera"></i>
                            </label>
                        </div>
                    </div>
                    <input type="file" id="avatarUpload" accept="image/*" style="display: none;">
                    
                    <h5 class="mb-1">@Model.FullName</h5>
                    <p class="text-muted mb-2">@@@Model.Username</p>
                    <span class="badge bg-@(Model.IsAdmin ? "danger" : "primary")">
                        @Model.RoleName
                    </span>
                </div>
                
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index", "Profile")" class="list-group-item list-group-item-action active">
                        <i class="bi bi-person me-2"></i> Thông tin cá nhân
                    </a>
                    <a href="@Url.Action("Edit", "Profile")" class="list-group-item list-group-item-action">
                        <i class="bi bi-pencil me-2"></i> Chỉnh sửa thông tin
                    </a>
                    <a href="@Url.Action("ChangePassword", "Profile")" class="list-group-item list-group-item-action">
                        <i class="bi bi-key me-2"></i> Đổi mật khẩu
                    </a>
                    @if (Model.IsAdmin)
                    {
                        <a href="@Url.Action("ManageUsers", "Profile")" class="list-group-item list-group-item-action">
                            <i class="bi bi-people me-2"></i> Quản lý người dùng
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Thông tin cơ bản -->
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Thông tin cơ bản</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">Họ và tên:</div>
                        <div class="col-md-9"><strong>@Model.FullName</strong></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">Tên đăng nhập:</div>
                        <div class="col-md-9"><strong>@Model.Username</strong></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">Email:</div>
                        <div class="col-md-9">
                            <strong>@Model.Email</strong>
                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge bg-success ms-2">
                                    <i class="bi bi-check-circle"></i> Đã xác thực
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning ms-2">
                                    <i class="bi bi-exclamation-circle"></i> Chưa xác thực
                                </span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">Vai trò:</div>
                        <div class="col-md-9">
                            <span class="badge bg-@(Model.IsAdmin ? "danger" : "primary")">
                                @Model.RoleName
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">Trạng thái:</div>
                        <div class="col-md-9">
                            <span class="badge bg-@(Model.IsActive ? "success" : "secondary")">
                                @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">Ngày tham gia:</div>
                        <div class="col-md-9"><strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    </div>
                    @if (Model.LastLogin.HasValue)
                    {
                        <div class="row">
                            <div class="col-md-3 text-muted">Đăng nhập lần cuối:</div>
                            <div class="col-md-9"><strong>@Model.LastLogin.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                        </div>
                    }
                </div>
            </div>

            <!-- Thống kê hoạt động -->
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Thống kê hoạt động</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="stat-box">
                                <i class="bi bi-heart-fill text-danger stat-icon"></i>
                                <h3 class="stat-number">@Model.TotalFavorites</h3>
                                <p class="stat-label">Yêu thích</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-box">
                                <i class="bi bi-chat-fill text-primary stat-icon"></i>
                                <h3 class="stat-number">@Model.TotalComments</h3>
                                <p class="stat-label">Bình luận</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-box">
                                <i class="bi bi-star-fill text-warning stat-icon"></i>
                                <h3 class="stat-number">@Model.TotalRatings</h3>
                                <p class="stat-label">Đánh giá</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-box">
                                <i class="bi bi-clock-history text-info stat-icon"></i>
                                <h3 class="stat-number">@Model.TotalWatchHistory</h3>
                                <p class="stat-label">Lịch sử xem</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Upload avatar
        document.getElementById('avatarUpload').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('avatar', file);

            try {
                const response = await fetch('@Url.Action("UpdateAvatar", "Profile")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });

                const result = await response.json();
                
                if (result.success) {
                    document.getElementById('profileAvatar').src = result.avatar + '?t=' + new Date().getTime();
                    alert(result.message);
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Có lỗi xảy ra khi upload avatar');
            }
        });
    </script>
}