@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@{
    // ===== ✅ BẮT ĐẦU KHỐI CHUẨN BỊ BIẾN SEO MẶC ĐỊNH =====
    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}";
    var defaultSeoImage = $"{baseUrl}/images/iconmoon.png";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="monetag" content="1bd43555dd0c57f4ee0258b218db6891">

    <!-- Web App & PWA iOS Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MoonPhim" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="MoonPhim" />

    <!-- Google AdSense Auto Ads Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8229451063311920"
            crossorigin="anonymous"></script>

    <!-- In-Page Push Position Fix (Đã loại trừ khung thông báo Noti, Chatbot, Toast để không bị kéo xuống dưới) -->
    <style>
        iframe[style*="fixed"],
        iframe[style*="position: fixed"],
        iframe[style*="position:fixed"],
        body > div[style*="fixed"]:not(#header):not(.navbar):not(.modal):not(#homeAdModal):not(#mobileBottomNav):not(#iosInstallPrompt):not([class*="noti"]):not([id*="noti"]):not([class*="notification"]):not([id*="notification"]):not([class*="toast"]):not([id*="toast"]):not([class*="chatbot"]):not([id*="chatbot"]),
        body > div[style*="position: fixed"]:not(#header):not(.navbar):not(.modal):not(#homeAdModal):not(#mobileBottomNav):not(#iosInstallPrompt):not([class*="noti"]):not([id*="noti"]):not([class*="notification"]):not([id*="notification"]):not([class*="toast"]):not([id*="toast"]):not([class*="chatbot"]):not([id*="chatbot"]),
        [class*="in-page-push"],
        [id*="ipp-container"] {
            top: auto !important;
            bottom: 85px !important;
            right: 20px !important;
            left: auto !important;
            z-index: 2147483647 !important;
        }
    </style>
    <title>@ViewData["Title"] - MoonPhim | Xem Phim Online Miễn Phí | Moon Phim Vietsub HD</title>

    <!-- Schema.org WebSite & Brand Organization Markup (MoonPhim / Moon Phim) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "MoonPhim",
      "alternateName": ["Moon Phim", "MoonPhim.me", "Moon Phim Online", "MoonPhim HD"],
      "url": "https://moonphim.me/",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "https://moonphim.me/tim-kiem?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <!-- Resource Preconnect & DNS-Prefetch for Fast Asset Loading -->
    <link rel="preconnect" href="https://img.ophim.live" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com">

    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true">
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nangcap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filter-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-bottom-nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moon-dialog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ios-pwa-prompt.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @* CHỈ LOAD notification.css và chatbot.css KHI USER ĐĂNG NHẬP *@
    @if (User.Identity.IsAuthenticated)
    {
        <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    }

    @* --- BẮT ĐẦU KHỐI SEO MẶC ĐỊNH --- *@
    <meta name="keywords" content="moonphim, moon phim, moonphim me, moon phim online, phimmoi, phim moi, rophim, ro phim, cobephim, co be phim, motphim, mot phim, motchill, phimmoichill, xem phim online, phim vietsub, phim thuyet minh, xem phim mien phi, bay bong cung dien anh" />
    <meta name="theme-color" content="#1c2a39" />
    <meta name="author" content="MoonPhim (Moon Phim)" />

    <meta property="og:site_name" content="MoonPhim (Moon Phim) - PhimMoi | RoPhim | MotPhim Vietsub Full HD" />
    <meta property="og:image" content="@defaultSeoImage" />
    <meta property="og:locale" content="vi_VN" />
    @* --- KẾT THÚC KHỐI SEO MẶC ĐỊNH --- *@

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(ViewData["IsHomePage"] as bool? == true ? "home-page" : "")"
    data-is-premium="@(ViewBag.IsPremium ?? false).ToString().ToLower()"
    data-is-series-type="@(ViewBag.IsSeriesType ?? false).ToString().ToLower()"
    data-user-logged-in="@User.Identity.IsAuthenticated.ToString().ToLower()">

    @{
        var token = antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" value="@token" />

    @await Html.PartialAsync("Partial/_Header")
    @await Html.PartialAsync("Partial/_AuthModal")
    @await Html.PartialAsync("Partial/_UpgradeAnnouncementModal")

    <main role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("Partial/_Footer")
    @await Html.PartialAsync("Partial/_MobileBottomNav")
    @await Html.PartialAsync("Partial/_IosInstallPrompt")

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("Partial/_Scripts")
    <script src="~/js/moon-dialog.js" asp-append-version="true"></script>
    <script src="~/js/mobile-bottom-nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    @if (User.Identity.IsAuthenticated)
{
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>

    var roleId = User.FindFirst("RoleId")?.Value;
    var subscriptionType = User.FindFirst("SubscriptionType")?.Value?.ToLower();
    
    bool canUseChatbot = roleId == "1" || 
                        subscriptionType == "premium" || 
                        subscriptionType == "student";

    if (canUseChatbot)
    {
        @await Html.PartialAsync("Partial/_Chatbot")
        <script src="~/js/chatbot.js" asp-append-version="true"></script>
    }
}

<script src="~/js/search.js" asp-append-version="true"></script>

    <!-- Monetag In-Page Push & Vignette (Chạy sau khi toàn bộ trang dựng xong qua Idle Callback) -->
    <script>
        window.addEventListener('load', function () {
            var loadMonetag = function () {
                // Nạp In-Page Push (Zone 11708841)
                var ipp = document.createElement('script');
                ipp.dataset.zone = '11708841';
                ipp.src = 'https://nap5k.com/tag.min.js';
                document.body.appendChild(ipp);

                // Nạp Vignette (Zone 11708850)
                var vig = document.createElement('script');
                vig.dataset.zone = '11708850';
                vig.src = 'https://n6wxm.com/vignette.min.js';
                document.body.appendChild(vig);
            };

            if ('requestIdleCallback' in window) {
                requestIdleCallback(loadMonetag, { timeout: 1200 });
            } else {
                setTimeout(loadMonetag, 600);
            }
        });
    </script>

    <!-- Monetag OnClick (Popunder) Ads Script - Chống vòng lặp chuyển hướng Mobile & Giới hạn 24h -->
    <script>
        (function () {
            var STORAGE_KEY = 'moonphim_pop_done';
            var COOLDOWN = 24 * 60 * 60 * 1000; // 24 tiếng

            var lastShown = localStorage.getItem(STORAGE_KEY);
            var now = Date.now();

            // 1. Đã bật trong 24h qua -> Chặn hoàn toàn
            if (lastShown && (now - parseInt(lastShown, 10)) < COOLDOWN) {
                return;
            }

            var isFired = false;

            var triggerPopunder = function () {
                if (isFired) return;
                isFired = true;

                // Ghi nhận ngay mốc thời gian để không lặp lại
                localStorage.setItem(STORAGE_KEY, Date.now().toString());

                // Gỡ toàn bộ sự kiện chạm/click ngay lập tức
                window.removeEventListener('click', triggerPopunder, { capture: true, passive: true });
                window.removeEventListener('touchend', triggerPopunder, { capture: true, passive: true });

                // Nạp script OnClick Monetag (Zone 11708858)
                var s = document.createElement('script');
                s.dataset.zone = '11708858';
                s.src = 'https://al5sm.com/tag.min.js';
                (document.body || document.documentElement).appendChild(s);
            };

            // Bắt sự kiện click hoặc nhả ngón tay ở chế độ passive để không chặn scrolling trên mobile
            window.addEventListener('click', triggerPopunder, { capture: true, passive: true });
            window.addEventListener('touchend', triggerPopunder, { capture: true, passive: true });
        })();
    </script>
</body>

</html>