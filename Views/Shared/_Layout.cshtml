    <meta name="theme-color" content="#1c2a39" />
    <meta name="author" content="MoonPhim (Moon Phim)" />

    <meta property="og:site_name" content="MoonPhim" />
    <meta property="og:image" content="@defaultSeoImage" />
    <meta property="og:locale" content="vi_VN" />
    @* --- KẾT THÚC KHỐI SEO MẶC ĐỊNH --- *@

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(ViewData["IsHomePage"] as bool? == true ? "home-page" : "")"
    data-is-premium="@(ViewBag.IsPremium ?? false).ToString().ToLower()"
    data-is-series-type="@(ViewBag.IsSeriesType ?? false).ToString().ToLower()"
    data-user-logged-in="@User.Identity.IsAuthenticated.ToString().ToLower()">

    @{
        var token = antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" value="@token" />

    @await Html.PartialAsync("Partial/_Header")
    @await Html.PartialAsync("Partial/_AuthModal")
    @await Html.PartialAsync("Partial/_UpgradeAnnouncementModal")

    <main role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("Partial/_Footer")
    @await Html.PartialAsync("Partial/_MobileBottomNav")
    @await Html.PartialAsync("Partial/_IosInstallPrompt")

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("Partial/_Scripts")
    <script src="~/js/moon-dialog.js" asp-append-version="true"></script>
    <script src="~/js/mobile-bottom-nav.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    @if (User.Identity.IsAuthenticated)
    {
        <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
        <script src="~/js/notification.js" asp-append-version="true"></script>
        @await Html.PartialAsync("Partial/_Chatbot")
        <script src="~/js/chatbot.js" asp-append-version="true"></script>
    }

<script src="~/js/search.js" asp-append-version="true"></script>

    <!-- Monetag Vignette (Chạy trên cả Web và App qua Idle Callback) -->
    <script>
        (function () {
            if (window.moonphimVignetteInitialized) return;
            window.moonphimVignetteInitialized = true;
            var loadMonetag = function () {
                if (document.querySelector('script[data-zone="11708850"]')) return;
                // Nạp Vignette (Zone 11708850)
                var vig = document.createElement('script');
                vig.dataset.zone = '11708850';
                vig.src = 'https://n6wxm.com/vignette.min.js';
                document.body.appendChild(vig);
            };

            if (document.readyState === 'complete') {
                setTimeout(loadMonetag, 800);
            } else {
                window.addEventListener('load', function () {
                    if ('requestIdleCallback' in window) {
                        requestIdleCallback(loadMonetag, { timeout: 1500 });
                    } else {
                        setTimeout(loadMonetag, 800);
                    }
                });
            }
        })();
    </script>

    @if (!hasSeenPopunder)
    {
        <!-- Monetag OnClick (Popunder) Ads Script - Chạy trên cả Mobile & Desktop - Tần suất: 2 tiếng / lần -->
        <script>
            (function () {
                const STORAGE_KEY = 'moonphim_pop_done';
                const COOLDOWN = 2 * 60 * 60 * 1000;
                const ZONE_ID = '11708858';

                const isAppContext = () => {
                    const userAgent = navigator.userAgent || '';
                    const isInstalledPwa = navigator.standalone === true ||
                        window.matchMedia?.('(display-mode: standalone)').matches === true ||
                        window.matchMedia?.('(display-mode: minimal-ui)').matches === true;
                    const isAndroidWebView = /Android/i.test(userAgent) && /\bwv\b/i.test(userAgent);
                    const isNativeApp = /\bMoonPhimApp\b/i.test(userAgent) ||
                        (document.referrer || '').startsWith('android-app://');
                    return isInstalledPwa || isAndroidWebView || isNativeApp;
                };

                // Disable website OnClick in installed apps; ordinary browser tabs keep it.
                if (isAppContext()) return;
                // Shared across SPA replays; a per-initializer flag cannot prevent duplicates.
                const state = window.moonphimOnclickState ||= { pending: false, loaded: false };

                const isCoolingDown = () => {
                    const hasCookie = document.cookie.split(';').some(cookie =>
                        cookie.trim().startsWith(STORAGE_KEY + '='));
                    if (hasCookie) return true;
                    try {
                        const lastLoaded = Number(localStorage.getItem(STORAGE_KEY));
                        return Number.isFinite(lastLoaded) && lastLoaded > 0 &&
                            Date.now() - lastLoaded < COOLDOWN;
                    } catch {
                        return false; // Safari storage restrictions: rely on the cookie/global state.
                    }
                };

                if (state.pending || state.loaded ||
                    document.querySelector('script[data-zone="' + ZONE_ID + '"]') || isCoolingDown()) {
                    return;
                }

                const triggerPopunder = () => {
                    window.removeEventListener('click', triggerPopunder);
                    state.pending = false;
                    // Another tab can start cooldown after this listener was registered.
                    if (isAppContext() || state.loaded || isCoolingDown()) return;
                    state.loaded = true;

                    try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
                    document.cookie = STORAGE_KEY + '=1; max-age=7200; path=/; samesite=lax';

                    if (navigator.sendBeacon) {
                        navigator.sendBeacon('/api/ads/record-popunder');
                    } else {
                        fetch('/api/ads/record-popunder', { method: 'POST', keepalive: true }).catch(() => {});
                    }

                    const script = document.createElement('script');
                    script.dataset.zone = ZONE_ID;
                    script.src = 'https://al5sm.com/tag.min.js';
                    (document.body || document.documentElement).appendChild(script);
                };

                state.pending = true;
                window.addEventListener('click', triggerPopunder, { once: true, passive: true });
            })();
        </script>
    }
</body>

</html>