@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache MemoryCache
@{
    // ===== ✅ BẮT ĐẦU KHỐI CHUẨN BỊ BIẾN SEO MẶC ĐỊNH =====
    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}";
    var defaultSeoImage = $"{baseUrl}/images/iconmoon.png";

    // ===== IP RATE LIMITING CHO QUẢNG CÁO ONCLICK (24H) =====
    var clientIp = Context.Request.Headers["X-Forwarded-For"].FirstOrDefault() 
                   ?? Context.Connection.RemoteIpAddress?.ToString() 
                   ?? "unknown";
    if (clientIp.Contains(",")) {
        clientIp = clientIp.Split(',')[0].Trim();
    }
    var ipCacheKey = $"monetag_pop_{clientIp}";
    var hasSeenPopunder = MemoryCache.TryGetValue(ipCacheKey, out _) 
                          || Context.Request.Cookies.ContainsKey("moonphim_pop_done");
}
