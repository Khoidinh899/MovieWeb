<script src="~/js/search.js" asp-append-version="true"></script>

    <!-- Monetag In-Page Push & Vignette (Chạy sau khi toàn bộ trang dựng xong qua Idle Callback) -->
    <script>
        window.addEventListener('load', function () {
            // Kiểm tra môi trường App (APK / iOS WebApp / Standalone)
            var isAppOrWebView = (window.navigator.standalone === true) || 
                                 window.matchMedia('(display-mode: standalone)').matches || 
                                 window.matchMedia('(display-mode: fullscreen)').matches ||
                                 navigator.userAgent.indexOf('MoonPhim') !== -1 ||
                                 navigator.userAgent.indexOf('wv') !== -1 ||
                                 (navigator.userAgent.indexOf('Android') !== -1 && navigator.userAgent.indexOf('Version/') !== -1) ||
                                 (/(iPhone|iPod|iPad).*AppleWebKit(?!.*Safari)/i.test(navigator.userAgent));
            if (isAppOrWebView) {
                return; // Không chạy quảng cáo ngoài luồng trong App
            }

            var loadMonetag = function () {
                // Nạp In-Page Push (Zone 11708841)
                var ipp = document.createElement('script');
                ipp.dataset.zone = '11708841';
                ipp.src = 'https://nap5k.com/tag.min.js';
                document.body.appendChild(ipp);

                // Nạp Vignette (Zone 11708850)
                var vig = document.createElement('script');
                vig.dataset.zone = '11708850';
                vig.src = 'https://n6wxm.com/vignette.min.js';
                document.body.appendChild(vig);
            };

            if ('requestIdleCallback' in window) {
                requestIdleCallback(loadMonetag, { timeout: 1200 });
            } else {
                setTimeout(loadMonetag, 600);
            }
        });
    </script>

    @if (!hasSeenPopunder)
    {
        <!-- Monetag OnClick (Popunder) Ads Script - CHỈ CHẠY TRÊN DESKTOP PC/LAPTOP - CHỐNG ẢNH HƯỞNG MOBILE -->
        <script>
            (function () {
                // 1. Kiểm tra nghiêm ngặt Thiết bị di động / Màn hình cảm ứng / App / Tablet
                var isMobileOrTouch = (window.navigator.standalone === true) || 
                                     window.matchMedia('(display-mode: standalone)').matches || 
                                     window.matchMedia('(display-mode: fullscreen)').matches ||
                                     window.matchMedia('(pointer: coarse)').matches ||
                                     (window.innerWidth < 1024) ||
                                     /(Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile|MoonPhim|wv)/i.test(navigator.userAgent);
                
                // Nếu là điện thoại / máy tính bảng / app -> Dừng hoàn toàn 100%, không nạp Popunder
                if (isMobileOrTouch) {
                    return;
                }

                var STORAGE_KEY = 'moonphim_pop_done';
                var COOLDOWN = 24 * 60 * 60 * 1000; // 24 tiếng

                var lastShown = localStorage.getItem(STORAGE_KEY);
                var hasCookie = document.cookie.indexOf('moonphim_pop_done=') !== -1;
                var now = Date.now();

                // 2. Đã bật trong 24h qua (LocalStorage hoặc Cookie) -> Chặn
                if (hasCookie || (lastShown && (now - parseInt(lastShown, 10)) < COOLDOWN)) {
                    return;
                }

                var isFired = false;

                var triggerPopunder = function () {
                    if (isFired) return;
                    isFired = true;

                    // Ghi nhận ngay mốc thời gian LocalStorage + Cookie 24h
                    localStorage.setItem(STORAGE_KEY, Date.now().toString());
                    document.cookie = "moonphim_pop_done=1; max-age=86400; path=/; samesite=lax";

                    // Gửi ghi nhận IP lên server (MemoryCache 24h)
                    if (navigator.sendBeacon) {
                        navigator.sendBeacon('/api/ads/record-popunder');
                    } else {
                        fetch('/api/ads/record-popunder', { method: 'POST', keepalive: true }).catch(function(){});
                    }

                    // Gỡ toàn bộ sự kiện ngay lập tức
                    window.removeEventListener('click', triggerPopunder);

                    // Nạp script OnClick Monetag (Zone 11708858) dành riêng cho Desktop
                    var s = document.createElement('script');
                    s.dataset.zone = '11708858';
                    s.src = 'https://al5sm.com/tag.min.js';
                    (document.body || document.documentElement).appendChild(s);
                };

                // Bắt sự kiện click bình thường
                window.addEventListener('click', triggerPopunder, { once: true, passive: true });
            })();
        </script>
    }
</body>

