@using Microsoft.AspNetCore.Identity
@inject MovieWeb.Services.IAuthService _authService

@{
    var currentUser = await _authService.GetCurrentUserAsync();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var isHomePage = currentPath == "/trang-chu" || currentPath == "/";
}

<header>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom"
         id="mainNavbar"
         data-is-homepage="@isHomePage.ToString().ToLower()">
        <div class="container-fluid">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center" href="/trang-chu">
                <img src="~/images/iconmoon.png" alt="MoonPhim Logo" style="height:60px; margin-right:8px;">
                <div style="display:flex; flex-direction:column; line-height:1.2;">
                    <span style="font-weight:bold; font-size:28px; color:white;">MoonPhim</span>
                    <span style="font-size:14px; color:rgba(255,255,255,0.7);">Bay bổng cùng điện ảnh</span>
                </div>
            </a>

            <!-- Mobile controls -->
            <div class="d-lg-none d-flex align-items-center">
                <button class="btn btn-link text-white me-2" id="mobileSearchBtn">
                    <i class="fas fa-search"></i>
                </button>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- Navbar content -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Navigation links -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/trang-chu">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/the-loai/phim-le">Phim lẻ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/the-loai/phim-bo">Phim bộ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/the-loai/hoat-hinh">Hoạt hình</a></li>
                    <li class="nav-item dropdown mega-dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="megaMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Thể Loại
                    </a>
                    <div class="dropdown-menu mega-menu" aria-labelledby="megaMenu">
                        <div class="mega-container">
                        <div class="row">
                            <div class="col-md-3 col-6">
                            <ul class="list-unstyled">
                                <li><a href="#">Hành Động</a></li>
                                <li><a href="#">Kinh Dị</a></li>
                                <li><a href="#">Phiêu Lưu</a></li>
                                <li><a href="#">Tình Cảm</a></li>
                                <li><a href="#">Lãng Mạn</a></li>
                            </ul>
                            </div>
                            <div class="col-md-3 col-6">
                            <ul class="list-unstyled">
                                <li><a href="#">Cổ Trang</a></li>
                                <li><a href="#">Hài Hước</a></li>
                                <li><a href="#">Hoạt Hình</a></li>
                                <li><a href="#">Tâm Lý</a></li>
                                <li><a href="#">Thần Thoại</a></li>
                            </ul>
                            </div>
                            <div class="col-md-3 col-6">
                            <ul class="list-unstyled">
                                <li><a href="#">Marvel</a></li>
                                <li><a href="#">Anime</a></li>
                                <li><a href="#">TV Show</a></li>
                                <li><a href="#">Chiếu Rạp</a></li>
                                <li><a href="#">Bí Ẩn</a></li>
                            </ul>
                            </div>
                            <div class="col-md-3 col-6">
                            <ul class="list-unstyled">
                                <li><a href="#">Hình Sự</a></li>
                                <li><a href="#">Học Đường</a></li>
                                <li><a href="#">Xuyên Không</a></li>
                                <li><a href="#">Game Show</a></li>
                                <li><a href="#">Thể Thao</a></li>
                            </ul>
                            </div>
                        </div>
                        </div>
                        @if (currentUser?.IsAdmin == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                <i class="bi bi-shield-lock-fill"></i> Admin
                            </a>
                        </li>
                    }
                    </div>
                    </li>
                </ul>

                <!-- Desktop search -->
                <form class="search-box d-none d-lg-flex" action="/tim-kiem" method="get">
                    <div class="search-input-wrapper">
                        <input type="search" name="keyword" placeholder="Tìm kiếm phim..." aria-label="Search">
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </div>
                </form>

                <!-- Desktop user menu -->
                <div class="dropdown ms-3 position-relative d-none d-lg-block">
                    @if (currentUser != null)
                    {
                        <a href="#"
                           class="d-flex align-items-center text-decoration-none dropdown-toggle user-dropdown-trigger"
                           id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@(string.IsNullOrEmpty(currentUser.Avatar) ? "/images/nouser.png" : currentUser.Avatar)"
                                 alt="Avatar" class="avatar-circle">
                            <span class="ms-2 text-white user-name">@(currentUser.FullName ?? currentUser.UserName)</span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-end shadow user-dropdown-custom"
                             aria-labelledby="userDropdown">
                            <div class="user-info-header">
                                <div class="d-flex align-items-center mb-3">
                                    <img src="@(string.IsNullOrEmpty(currentUser.Avatar) ? "/images/nouser.png" : currentUser.Avatar)"
                                         alt="Avatar" class="avatar-circle-large me-3">
                                    <div>
                                        <h5 class="mb-1 text-white">@(currentUser.FullName ?? currentUser.UserName)</h5>
                                        <p class="text-light small mb-0">@currentUser.Email</p>
                                    </div>
                                </div>
                                <p class="text-light small mb-2">Nâng cấp tài khoản MoonX để có trải nghiệm đẳng cấp hơn.</p>
                                <a href="/nang-cap" class="btn-upgrade w-100">
                                    <i class="bi bi-star-fill me-1"></i>Nâng cấp ngay
                                </a>
                            </div>

                            <div class="dropdown-divider"></div>

                            @if (currentUser.IsAdmin)
                            {
                                <a class="dropdown-item dropdown-item-custom" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="bi bi-shield-lock-fill me-2"></i>
                                    <span>Admin Panel</span>
                                </a>
                                <div class="dropdown-divider"></div>
                            }

                            <a class="dropdown-item dropdown-item-custom" href="/yeu-thich">
                                <i class="bi bi-heart me-2"></i>
                                <span>Yêu thích</span>
                            </a>
                            <a class="dropdown-item dropdown-item-custom" href="#">
                                <i class="bi bi-collection me-2"></i>
                                <span>Danh sách</span>
                            </a>
                            <a class="dropdown-item dropdown-item-custom" href="#">
                                <i class="bi bi-clock-history me-2"></i>
                                <span>Xem tiếp</span>
                            </a>
                            <a class="dropdown-item dropdown-item-custom" href="/user/profile">
                                <i class="bi bi-person me-2"></i>
                                <span>Tài khoản</span>
                            </a>

                            <div class="dropdown-divider"></div>

                            <a class="dropdown-item dropdown-item-custom text-danger" href="#"
                               onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                <span>Đăng xuất</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-outline-light d-flex align-items-center btn-login" data-bs-toggle="modal"
                                data-bs-target="#authModal">
                            <i class="bi bi-person-circle me-2"></i>
                            Thành viên
                        </button>
                    }
                </div>

                <!-- Mobile user menu -->
                <div class="d-lg-none mt-3 pt-3 border-top border-secondary">
                    @if (currentUser != null)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <img src="@(string.IsNullOrEmpty(currentUser.Avatar) ? "/images/nouser.png" : currentUser.Avatar)"
                                 alt="Avatar" class="avatar-circle me-3">
                            <div>
                                <div class="text-white fw-bold">@(currentUser.FullName ?? currentUser.UserName)</div>
                                <small class="text-muted">@currentUser.Email</small>
                            </div>
                        </div>
                        <ul class="navbar-nav">
                            @if (currentUser.IsAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                        <i class="bi bi-shield-lock-fill me-2"></i>Admin Panel
                                    </a>
                                </li>
                            }
                            <li class="nav-item"><a class="nav-link" href="/user/profile"><i class="bi bi-person me-2"></i>Quản lý tài khoản</a></li>
                            <li class="nav-item"><a class="nav-link" href="/yeu-thich"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
                            <li class="nav-item"><a class="nav-link" href="/thong-bao"><i class="bi bi-bell me-2"></i>Thông báo</a></li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" href="#"
                                   onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <button class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center"
                                data-bs-toggle="modal" data-bs-target="#authModal">
                            <i class="bi bi-person-circle me-2"></i>
                            Đăng nhập / Đăng ký
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Logout form -->
    <form id="logoutForm" method="post" asp-controller="Auth" asp-action="Logout" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</header>