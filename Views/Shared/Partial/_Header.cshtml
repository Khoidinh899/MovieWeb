                        </div>
                        </div>
                    </div>
                    </li>

                    
                    @{
                        var currentUser = await _authService.GetCurrentUserAsync();
                        if (currentUser?.IsAdmin == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="bi bi-shield-lock-fill"></i> Admin
                                </a>
                            </li>
                        }
                    }
                </ul>

                <!-- Search box desktop -->
                <form class="search-box d-none d-lg-flex" action="/tim-kiem" method="get">
                    <div class="search-input-wrapper">
                        <input type="search" name="keyword" placeholder="Tìm kiếm phim..." aria-label="Search">
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </div>
                </form>

                <!-- Desktop Login/User Section -->
                        <div class="dropdown ms-3 position-relative d-none d-lg-block">
                    @if (currentUser != null)
                    {
                <!-- Đã đăng nhập -->
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle"
                             id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@(string.IsNullOrEmpty(currentUser.Avatar) ? "/images/nouser.png" : currentUser.Avatar)" 
                            alt="Avatar" class="avatar-circle">
                        <span class="ms-2 text-white">@(currentUser.FullName ?? currentUser.UserName)</span>
                    </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                            @if (currentUser.IsAdmin)
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Dashboard", "Admin")">
                                        <i class="bi bi-shield-lock-fill me-2"></i>Admin Panel
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li><a class="dropdown-item" href="/tai-khoan"><i class="bi bi-person me-2"></i>Quản lý tài khoản</a></li>
                            <li><a class="dropdown-item" href="/yeu-thich"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
                            <li><a class="dropdown-item" href="/thong-bao"><i class="bi bi-bell me-2"></i>Thông báo</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Chưa đăng nhập -->
                        <button class="btn btn-outline-light d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#authModal">
                            <i class="bi bi-person-circle me-2"></i>
                            Thành viên
                        </button>
                    }
                </div>

                <!-- Mobile Login Section -->
                <div class="d-lg-none mt-3 pt-3 border-top border-secondary">
                    @if (currentUser != null)
                    {
                        <!-- Đã đăng nhập (Mobile) -->
                        <div class="d-flex align-items-center mb-3">
                            <img src="@(string.IsNullOrEmpty(currentUser.Avatar) ? "/images/nouser.png" : currentUser.Avatar)" 
                                 alt="Avatar" class="avatar-circle me-3">
                            <div>
                                <div class="text-white fw-bold">@(currentUser.FullName ?? currentUser.UserName)</div>
                                <small class="text-muted">@currentUser.Email</small>
                            </div>
                        </div>
                        <ul class="navbar-nav">
                            @if (currentUser.IsAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                        <i class="bi bi-shield-lock-fill me-2"></i>Admin Panel
                                    </a>
                                </li>
                            }
                            <li class="nav-item"><a class="nav-link" href="/tai-khoan"><i class="bi bi-person me-2"></i>Quản lý tài khoản</a></li>
                            <li class="nav-item"><a class="nav-link" href="/yeu-thich"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
                            <li class="nav-item"><a class="nav-link" href="/thong-bao"><i class="bi bi-bell me-2"></i>Thông báo</a></li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" href="#" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Chưa đăng nhập (Mobile) -->
                        <button class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#authModal">
                            <i class="bi bi-person-circle me-2"></i>
                            Đăng nhập / Đăng ký
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>
    
    <!-- Logout Form (ẩn) -->
    <form id="logoutForm" method="post" asp-controller="Auth" asp-action="Logout" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</header>