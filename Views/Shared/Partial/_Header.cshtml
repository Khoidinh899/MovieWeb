                            <div class="col-md-3 col-6">
                            <ul class="list-unstyled">
                                <li><a href="#">Marvel</a></li>
                                <li><a href="#">Anime</a></li>
                                <li><a href="#">TV Show</a></li>
                                <li><a href="#">Chiếu Rạp</a></li>
                                <li><a href="#">Bí Ẩn</a></li>
                            </ul>
