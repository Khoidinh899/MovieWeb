@* Partial View: _UpgradeAnnouncementModal.cshtml - Hệ thống Popup Thông báo Động từ Dashboard *@
@inject MovieWeb.Services.Interfaces.IAnnouncementService AnnouncementService
@{
    var settings = await AnnouncementService.GetSettingsAsync();
    if (settings == null || !settings.IsEnabled)
    {
        return;
    }
}

<div class="modal fade" id="upgradeAnnouncementModal" tabindex="-1" aria-labelledby="upgradeAnnouncementModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content midautumn-modal-content">
            <!-- Nút đóng góc phải nổi bật -->
            <button type="button" class="midautumn-modal-close" onclick="closeMidAutumnModal()" aria-label="Đóng" title="Đóng thông báo">
                <i class="bi bi-x-lg"></i>
            </button>
            
            <div class="modal-body p-3 p-md-4">
                <!-- Header Banner -->
                @if (!string.IsNullOrWhiteSpace(settings.BadgeText) || !string.IsNullOrWhiteSpace(settings.Title))
                {
                    <div class="text-center mb-3">
                        @if (!string.IsNullOrWhiteSpace(settings.BadgeText))
                        {
                            <div class="midautumn-badge-glow mb-1">
                                <span class="badge-tag">@settings.BadgeText</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.Title))
                        {
                            <h3 class="midautumn-modal-title" id="upgradeAnnouncementModalLabel">
                                @settings.Title
                            </h3>
                        }
                    </div>
                }

                <!-- Lời chúc / Thông điệp chính -->
                @if (!string.IsNullOrWhiteSpace(settings.MainMessageHtml))
                {
                    <div class="midautumn-card-box mb-3">
                        @Html.Raw(settings.MainMessageHtml)
                    </div>
                }

                <!-- Khối Thông Báo Kỹ Thuật / Chi Tiết -->
                @if (!string.IsNullOrWhiteSpace(settings.NoticeHeaderHtml) || !string.IsNullOrWhiteSpace(settings.NoticeBodyHtml))
                {
                    <div class="midautumn-notice-box mb-3">
                        @if (!string.IsNullOrWhiteSpace(settings.NoticeHeaderHtml))
                        {
                            <div class="notice-header mb-2">
                                @Html.Raw(settings.NoticeHeaderHtml)
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.NoticeBodyHtml))
                        {
                            @Html.Raw(settings.NoticeBodyHtml)
                        }
                    </div>
                }

                <!-- Nút Hành Động -->
                <div class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(settings.ButtonUrl))
                    {
                        <a href="@settings.ButtonUrl" class="btn btn-midautumn-primary w-100 py-2 py-md-3 text-center text-decoration-none d-block" onclick="closeMidAutumnModal()">
                            @settings.ButtonText
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-midautumn-primary w-100 py-2 py-md-3" onclick="closeMidAutumnModal()">
                            @settings.ButtonText
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ===================================================
   MODAL POPUP THÔNG BÁO - MOONPHIM THEME
   =================================================== */
#upgradeAnnouncementModal {
    z-index: 1065 !important;
}

.midautumn-modal-content {
    background: linear-gradient(145deg, #091224 0%, #0f1c3f 60%, #17112d 100%);
    border: 1.5px solid rgba(250, 204, 21, 0.45);
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 35px rgba(250, 204, 21, 0.25);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    position: relative;
    overflow: hidden;
    color: #e2e8f0;
}

.midautumn-modal-content::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 50% 10%, rgba(250, 204, 21, 0.12) 0%, transparent 60%);
    pointer-events: none;
}

.midautumn-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 30;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #ffffff;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.midautumn-modal-close:hover {
    background: #ef4444;
    border-color: #f87171;
    color: #ffffff;
    transform: scale(1.1) rotate(90deg);
}

.midautumn-badge-glow .badge-tag {
    display: inline-block;
    padding: 4px 14px;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.6);
    border-radius: 30px;
    color: #fca5a5;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

.midautumn-modal-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, #ffffff 0%, #facc15 50%, #fb923c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0;
}

.midautumn-card-box {
    padding: 12px 14px;
    background: rgba(250, 204, 21, 0.08);
    border: 1px solid rgba(250, 204, 21, 0.3);
    border-radius: 12px;
    line-height: 1.5;
    font-size: 0.9rem;
    color: #fef08a;
}

.midautumn-notice-box {
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.45;
}

.notice-header {
    font-size: 0.88rem;
    letter-spacing: 0.3px;
}

.notice-item {
    display: flex;
    align-items: flex-start;
    color: #cbd5e1;
}

.btn-midautumn-primary {
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 50%, #ea580c 100%);
    border: none;
    color: #0f172a;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(234, 179, 8, 0.4);
    transition: all 0.3s ease;
}

.btn-midautumn-primary:hover {
    background: linear-gradient(135deg, #facc15 0%, #eab308 50%, #f97316 100%);
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(250, 204, 21, 0.6);
}

/* ===================================================
   RESPONSIVE: VỪA KHÍT 1 MÀN HÌNH THIẾT BỊ
   =================================================== */
@@media (max-width: 768px) {
    #upgradeAnnouncementModal .modal-dialog {
        margin: 60px 12px 12px 12px !important;
        max-width: calc(100% - 24px);
    }

    .midautumn-modal-content {
        max-height: calc(92vh - 60px);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 14px;
    }

    .midautumn-modal-content .modal-body {
        padding: 16px 14px 14px 14px !important;
    }

    .midautumn-modal-title {
        font-size: 1.15rem;
    }

    .midautumn-badge-glow .badge-tag {
        font-size: 0.72rem;
        padding: 3px 10px;
    }

    .midautumn-card-box {
        font-size: 0.82rem;
        padding: 10px 12px;
    }

    .midautumn-notice-box {
        font-size: 0.78rem;
        padding: 10px 12px;
    }

    .btn-midautumn-primary {
        font-size: 0.88rem;
    }
}
</style>

<script>
    (function () {
        const STORAGE_KEY = 'moonphim_announcement_seen_@(settings.StorageKeyVersion)';
        const SHOW_ONCE = @(settings.ShowOncePerUser ? "true" : "false");

        // Đánh dấu đã xem (cả LocalStorage lẫn Cookie 1 năm)
        function markAsSeen() {
            if (!SHOW_ONCE) return;
            try {
                localStorage.setItem(STORAGE_KEY, '1');
                document.cookie = STORAGE_KEY + "=1; max-age=31536000; path=/; samesite=lax";
            } catch (e) {}
        }

        function hasSeen() {
            if (!SHOW_ONCE) return false;
            try {
                if (localStorage.getItem(STORAGE_KEY) === '1') return true;
                if (document.cookie.indexOf(STORAGE_KEY + '=1') !== -1) return true;
            } catch (e) {}
            return false;
        }

        window.closeMidAutumnModal = function () {
            markAsSeen();

            const modalEl = document.getElementById('upgradeAnnouncementModal');
            if (modalEl) {
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                } else {
                    modalEl.classList.remove('show');
                    modalEl.style.display = 'none';
                    document.body.classList.remove('modal-open');
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.remove();
                }
            }
        };

        function checkAndShowModal() {
            if (hasSeen()) {
                return;
            }

            markAsSeen();

            setTimeout(function () {
                const modalEl = document.getElementById('upgradeAnnouncementModal');
                if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    const modal = new bootstrap.Modal(modalEl, {
                        keyboard: true,
                        backdrop: 'static'
                    });
                    modal.show();
                }
            }, 1000);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', checkAndShowModal);
        } else {
            checkAndShowModal();
        }
    })();
</script>
