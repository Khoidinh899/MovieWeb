</style>

<script>
    (function () {
        const STORAGE_KEY = 'moonphim_upgrade_popup_2409';

        window.closeUpgradeModal = function () {
            const checkbox = document.getElementById('dontShowUpgradeModalAgain');
            if (checkbox && checkbox.checked) {
                localStorage.setItem(STORAGE_KEY, 'dismissed');
            }

            const modalEl = document.getElementById('upgradeAnnouncementModal');
            if (modalEl) {
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                } else {
                    modalEl.classList.remove('show');
                    modalEl.style.display = 'none';
                    document.body.classList.remove('modal-open');
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.remove();
                }
            }
        };

        window.openAuthFromUpgradeModal = function () {
            closeUpgradeModal();

            // Mở Auth Modal nếu có
            const authModalEl = document.getElementById('authModal');
            if (authModalEl) {
                setTimeout(() => {
                    const authModal = new bootstrap.Modal(authModalEl);
                    authModal.show();
                }, 350);
            }
        };

        // Tự động kích hoạt hiển thị sau khi trang tải xong 1.5 giây
        document.addEventListener('DOMContentLoaded', function () {
            const isDismissed = localStorage.getItem(STORAGE_KEY) === 'dismissed';
            if (isDismissed) {
                return; // Người dùng đã chọn không hiển thị lại -> Bỏ qua
            }

            setTimeout(function () {
                const modalEl = document.getElementById('upgradeAnnouncementModal');
                if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    const upgradeModal = new bootstrap.Modal(modalEl, {
                        keyboard: true,
                        backdrop: 'static'
                    });
                    upgradeModal.show();
                }
            }, 1200);
        });
    })();
</script>
