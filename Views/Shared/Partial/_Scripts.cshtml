<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (!Context.Request.Path.StartsWithSegments("/Admin"))
{
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
<script>
(function() {
    'use strict';
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
    function init() {
        console.log("✅ DOM Ready. Initializing features...");
        initNavbarAndScroll();
        initMobileSearch();
        initMobileMenu();
        initNotifications();
    }
    
    // ===== NAVBAR & SCROLL =====
    function initNavbarAndScroll() {
        const navbar = document.getElementById('mainNavbar');
        const scrollBtn = document.getElementById('scrollTopBtn');
        const body = document.body;

        if (!navbar) {
            console.log("⚠️ Navbar not found. Aborting scroll effects.");
            return;
        }

        console.log("✅ Navbar found. Setting up scroll listener...");

        const isHomePage = body.classList.contains('home-page');
        
        // Force set initial state bằng inline style
        if (isHomePage && window.innerWidth >= 992) {
            navbar.style.background = 'transparent';
            navbar.style.boxShadow = 'none';
        }

        let ticking = false;

        function handleScroll() {
            const scrollPosition = window.pageYOffset || document.documentElement.scrollTop;
            
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    const isDesktop = window.innerWidth >= 992;
                    
                    if (isHomePage && isDesktop) {
                        if (scrollPosition > 50) {
                            navbar.style.background = 'linear-gradient(135deg, #012c42 0%, #015487 50%, #0477eb 100%)';
                            navbar.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.3)';
                            navbar.classList.add('navbar-scrolled');
                        } else {
                            navbar.style.background = 'transparent';
                            navbar.style.boxShadow = 'none';
                            navbar.classList.remove('navbar-scrolled');
                        }
                    } else if (isHomePage && !isDesktop) {
                        navbar.style.background = 'linear-gradient(135deg, #012c42 0%, #015487 50%, #0477eb 100%)';
                        navbar.style.boxShadow = '0 2px 10px rgba(0, 0, 0, 0.3)';
                        navbar.classList.remove('navbar-scrolled');
                    }

                    if (scrollBtn) {
                        if (scrollPosition > 300) {
                            scrollBtn.classList.add('show');
                        } else {
                            scrollBtn.classList.remove('show');
                        }
                    }
                    
                    ticking = false;
                });
                ticking = true;
            }
        }

        window.addEventListener('scroll', handleScroll, { passive: true });

        window.addEventListener('resize', () => {
            if (window.innerWidth < 992 && isHomePage) {
                navbar.style.background = 'linear-gradient(135deg, #012c42 0%, #015487 50%, #0477eb 100%)';
                navbar.style.boxShadow = '0 2px 10px rgba(0, 0, 0, 0.3)';
                navbar.classList.remove('navbar-scrolled');
            } else if (window.innerWidth >= 992 && isHomePage && window.pageYOffset === 0) {
                navbar.style.background = 'transparent';
                navbar.style.boxShadow = 'none';
            }
            handleScroll();
        });

        handleScroll();
        
        if (scrollBtn) {
            scrollBtn.addEventListener('click', (e) => {
                e.preventDefault();
                window.scrollTo({ 
                    top: 0, 
                    behavior: 'smooth' 
                });
                console.log("🚀 Scrolling to top...");
            });
            console.log("✅ Scroll to top button initialized.");
        }
    }

    // ===== MOBILE SEARCH =====
    function initMobileSearch() {
        const mobileSearchBtn = document.getElementById('mobileSearchBtn');
        const mobileSearchOverlay = document.getElementById('mobileSearchOverlay');
        const mobileSearchClose = document.getElementById('mobileSearchClose');
        const mobileSearchInput = document.getElementById('mobileSearchInput');
        
        if (!mobileSearchBtn || !mobileSearchOverlay) {
            console.log("⚠️ Mobile search elements not found.");
            return;
        }
        
        console.log("✅ Initializing mobile search...");
        
        function closeMobileSearch() {
            mobileSearchOverlay.classList.remove('active');
            document.body.classList.remove('search-overlay-active');
            console.log("🔍 Mobile search closed");
        }
        
        mobileSearchBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            mobileSearchOverlay.classList.add('active');
            document.body.classList.add('search-overlay-active');
            console.log("🔍 Mobile search opened");
            setTimeout(() => {
                if (mobileSearchInput) mobileSearchInput.focus();
            }, 300);
        });
        
        if (mobileSearchClose) {
            mobileSearchClose.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeMobileSearch();
            });
        }
        
        mobileSearchOverlay.addEventListener('click', function(e) {
            if (e.target === mobileSearchOverlay) {
                closeMobileSearch();
            }
        });
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && mobileSearchOverlay.classList.contains('active')) {
                closeMobileSearch();
            }
        });
        
        const suggestionTags = document.querySelectorAll('.suggestion-tag');
        suggestionTags.forEach(tag => {
            tag.addEventListener('click', function() {
                if (mobileSearchInput) {
                    mobileSearchInput.value = this.textContent;
                    mobileSearchInput.focus();
                }
            });
        });
        
        console.log("✅ Mobile search initialized successfully!");
    }

    // ===== MOBILE MENU (OFFCANVAS) =====
    function initMobileMenu() {
        const menuToggleBtn = document.getElementById('myMenuToggleButton');
        const offcanvasElement = document.getElementById('mobileMenuOffcanvas');
        
        if (!menuToggleBtn || !offcanvasElement) {
            console.log("⚠️ Mobile menu elements not found.");
            return;
        }
        
        console.log("✅ Initializing mobile menu...");
        
        // Khởi tạo Bootstrap Offcanvas
        const bsOffcanvas = new bootstrap.Offcanvas(offcanvasElement);
        
        // Toggle menu khi click button
        menuToggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            console.log("📱 Mobile menu toggle clicked");
            bsOffcanvas.toggle();
        });
        
        // Event listeners cho offcanvas
        offcanvasElement.addEventListener('show.bs.offcanvas', function () {
            console.log("📱 Mobile menu opening...");
        });
        
        offcanvasElement.addEventListener('shown.bs.offcanvas', function () {
            console.log("✅ Mobile menu opened!");
        });
        
        offcanvasElement.addEventListener('hide.bs.offcanvas', function () {
            console.log("📱 Mobile menu closing...");
        });
        
        console.log("✅ Mobile menu initialized successfully!");
    }

// ===== NOTIFICATIONS =====
function initNotifications() {
    const notificationTriggers = document.querySelectorAll('.notification-trigger');
    const notificationDropdown = document.querySelector('.notification-dropdown');

    if (!notificationDropdown || notificationTriggers.length === 0) {
        console.log("⚠️ Notification elements not found.");
        return;
    }

    console.log("✅ Initializing notifications (universal)...");

    // Di chuyển dropdown ra <body>
    document.body.appendChild(notificationDropdown);
    
    // *** THAY ĐỔI QUAN TRỌNG SỐ 1 ***
    // Chuyển sang 'fixed' để nó "dính" vào cửa sổ trình duyệt,
    // và sẽ di chuyển CÙNG với header khi cuộn trang.
    notificationDropdown.style.position = 'fixed'; 
    notificationDropdown.style.zIndex = '1050'; // Đảm bảo nó nổi lên trên navbar (1030)

    // Hàm toggle dropdown (ĐÃ CẬP NHẬT)
    function toggleNotificationDropdown(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const triggerBtn = e.currentTarget;
        const isVisible = notificationDropdown.style.display === 'block';

        if (isVisible) {
            notificationDropdown.style.display = 'none';
            notificationDropdown.classList.remove('show');
            console.log("🔕 Notification dropdown closed");
        } else {
            // Tìm "mỏ neo" để căn chỉnh (desktop hoặc mobile)
            const desktopWrapper = triggerBtn.closest('#notificationBell');
            const anchorElement = desktopWrapper ? desktopWrapper : triggerBtn;
            
            // Lấy tọa độ của "mỏ neo" (so với viewport)
            const rect = anchorElement.getBoundingClientRect();
            
            // *** THAY ĐỔI QUAN TRỌNG SỐ 2 ***
            // Vì đã dùng 'position: fixed', vị trí được tính so với viewport.
            // Chúng ta KHÔNG CẦN cộng 'window.scrollY' nữa.
            notificationDropdown.style.top = `${rect.bottom + 5}px`; // +5px bên dưới icon
            
            // Căn lề phải (logic này vẫn đúng vì nó dựa trên viewport)
            notificationDropdown.style.right = `${window.innerWidth - rect.right}px`;
            notificationDropdown.style.left = 'auto'; // Reset lề trái

            // Tùy chỉnh cho màn hình mobile quá nhỏ
            if (window.innerWidth < 480) {
                notificationDropdown.style.right = '10px';
                notificationDropdown.style.left = '10px';
            }

            notificationDropdown.style.display = 'block';
            notificationDropdown.classList.add('show');
            console.log("🔔 Notification dropdown opened");
        }
    }

    // Gán sự kiện cho cả 2 chuông
    notificationTriggers.forEach(trigger => {
        trigger.addEventListener('click', toggleNotificationDropdown);
    });

    // Đóng dropdown khi click ra ngoài (giữ nguyên)
    document.addEventListener('click', function (e) {
        let clickedOnTrigger = false;
        notificationTriggers.forEach(trigger => {
            if (trigger.contains(e.target)) {
                clickedOnTrigger = true;
            }
        });

        if (
            notificationDropdown.style.display === 'block' &&
            !notificationDropdown.contains(e.target) &&
            !clickedOnTrigger
        ) {
            notificationDropdown.style.display = 'none';
            notificationDropdown.classList.remove('show');
        }
    });

    // --- Logic bên trong dropdown (giữ nguyên) ---

    // Tab switching
    const notificationTabs = document.querySelectorAll('.notification-header .nav-link');
    notificationTabs.forEach(tab => {
        tab.addEventListener('click', function () {
            notificationTabs.forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            console.log(`🔔 Switched to ${this.dataset.tab} tab`);
        });
    });

    // Mark all as read
    const markAllReadBtn = document.querySelector('.mark-all-read');
    if (markAllReadBtn) {
        markAllReadBtn.addEventListener('click', function (e) {
            e.preventDefault();
            console.log("✅ Mark all notifications as read");
        });
    }

    console.log("✅ Notifications initialized successfully for all devices!");
}
})();
</script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/js/notification.js" asp-append-version="true"></script>