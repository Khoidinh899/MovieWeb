@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!-- Login/Register/ForgotPassword/ResetPassword Modal -->
<div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content auth-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white" id="authModalTitle">Đăng nhập</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- ============= LOGIN FORM ============= -->
                <div id="loginForm">
                    <div class="text-center mb-4">
                        <img src="~/images/iconmoon.png" alt="MoonPhim" style="height: 60px;">
                        <h4 class="text-white mt-2">MoonPhim</h4>
                        <p class="text-muted">Bay bổng cùng điện ảnh</p>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <small>@TempData["ErrorMessage"]</small>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.5rem 0.5rem;"></button>
                        </div>
                    }

                    <form id="loginFormSubmit" asp-controller="Auth" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label text-white">Email</label>
                            <input type="email" class="form-control auth-input" id="loginEmail" name="Email" required placeholder="example@gmail.com">
                        </div>

                        <div class="mb-3">
                            <label for="loginPassword" class="form-label text-white">Mật khẩu</label>
                            <input type="password" class="form-control auth-input" id="loginPassword" name="Password" required placeholder="••••••••">
                        </div>

                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="loginRememberMe" name="RememberMe" value="true">
                                <label class="form-check-label text-muted" for="loginRememberMe" style="cursor: pointer; font-size: 0.9rem;">Lưu đăng nhập</label>
                            </div>
                            <a href="#" id="showForgotPassword" class="text-muted small">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3 auth-btn">
                            <span id="loginBtnText">Đăng nhập</span>
                            <span id="loginLoader" class="spinner-border spinner-border-sm d-none ms-2"></span>
                        </button>
                    </form>

                    <div class="d-grid gap-2 mb-3">
                        <a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Google" class="btn btn-outline-light d-flex align-items-center justify-content-center auth-btn-google">
                            <i class="fab fa-google me-2"></i>
                            Tiếp tục với Google
                        </a>
                    </div>

                    <hr class="bg-secondary">

                    <div class="text-center">
                        <p class="text-muted mb-0">
                            Chưa có tài khoản? 
                            <a href="#" id="showRegister" class="text-primary fw-bold">Đăng ký ngay</a>
                        </p>
                    </div>
                </div>

                <!-- ============= REGISTER FORM ============= -->
                <div id="registerForm" class="d-none">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus-fill text-primary" style="font-size: 3rem;"></i>
                        <h5 class="text-white mt-3">Tạo tài khoản mới</h5>
                        <p class="text-muted">Đăng ký để trải nghiệm đầy đủ tính năng</p>
                    </div>

                    <form id="registerFormSubmit" asp-controller="Auth" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="registerEmail" class="form-label text-white">Email</label>
                            <input type="email" class="form-control auth-input" id="registerEmail" name="Email" required placeholder="example@gmail.com">
                        </div>

                        <div class="mb-3">
                            <label for="registerUsername" class="form-label text-white">Tên đăng nhập</label>
                            <input type="text" class="form-control auth-input" id="registerUsername" name="Username" required placeholder="Tên hiển thị">
                            <small class="form-text text-muted">Chỉ chứa chữ cái, số, dấu gạch dưới (_) hoặc chấm (.)</small>
                        </div>

                        <div class="mb-3">
                            <label for="registerPassword" class="form-label text-white">Mật khẩu</label>
                            <input type="password" class="form-control auth-input" id="registerPassword" name="Password" required placeholder="Tối thiểu 6 ký tự">
                            <small class="form-text text-muted">Mật khẩu tối thiểu 6 ký tự</small>
                        </div>

                        <div class="mb-3">
                            <label for="registerConfirmPassword" class="form-label text-white">Xác nhận mật khẩu</label>
                            <input type="password" class="form-control auth-input" id="registerConfirmPassword" name="ConfirmPassword" required placeholder="Nhập lại mật khẩu">
                        </div>

                        <div class="mb-3">
                            <label for="registerFullName" class="form-label text-white">Họ và tên</label>
                            <input type="text" class="form-control auth-input" id="registerFullName" name="FullName" required placeholder="Nguyễn Văn A">
                        </div>

                        <!-- Cloudflare Turnstile widget -->
                        <div class="mb-3 d-flex justify-content-center">
                            <div class="cf-turnstile" data-sitekey="@Configuration["Turnstile:SiteKey"]" data-theme="dark"></div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3 auth-btn">
                            <span id="registerBtnText">Đăng ký</span>
                            <span id="registerLoader" class="spinner-border spinner-border-sm d-none ms-2"></span>
                        </button>
                    </form>

                    <div class="text-center">
                        <p class="text-muted mb-0">
                            Đã có tài khoản? 
                            <a href="#" id="showLogin" class="text-primary fw-bold">Đăng nhập</a>
                        </p>
                    </div>
                </div>

                <!-- ============= FORGOT PASSWORD FORM ============= -->
                <div id="forgotPasswordForm" class="d-none">
                    <div class="text-center mb-4">
                        <i class="bi bi-key-fill text-warning" style="font-size: 3rem;"></i>
                        <h5 class="text-white mt-3">Quên mật khẩu?</h5>
                        <p class="text-muted">Nhập email của bạn, chúng tôi sẽ gửi link đặt lại mật khẩu</p>
                    </div>

                    <form id="forgotPasswordFormSubmit" method="post">
                        @* ✅ THÊM TOKEN *@
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="forgotEmail" class="form-label text-white">Email</label>
                            <input type="email" class="form-control auth-input" id="forgotEmail" name="Email" required placeholder="example@gmail.com">
                        </div>

                        <button type="submit" class="btn btn-warning w-100 mb-3 auth-btn">
                            <span id="forgotBtnText">Gửi yêu cầu</span>
                            <span id="forgotLoader" class="spinner-border spinner-border-sm d-none ms-2"></span>
                        </button>
                    </form>

                    <div class="text-center">
                        <a href="#" id="backToLoginFromForgot" class="text-muted">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>

                <!-- ============= RESET PASSWORD FORM ============= -->
                <div id="resetPasswordForm" class="d-none">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock-fill text-success" style="font-size: 3rem;"></i>
                        <h5 class="text-white mt-3">Đặt lại mật khẩu</h5>
                        <p class="text-muted">Nhập mật khẩu mới cho tài khoản của bạn</p>
                    </div>

                    <form id="resetPasswordFormSubmit" method="post">
                        @* ✅ THÊM TOKEN *@
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" id="resetUserId" name="UserId">
                        <input type="hidden" id="resetToken" name="Token">

                        <div class="mb-3">
                            <label for="newPassword" class="form-label text-white">Mật khẩu mới</label>
                            <input type="password" class="form-control auth-input" id="newPassword" name="NewPassword" required placeholder="Tối thiểu 6 ký tự">
                            <small class="form-text text-muted">Mật khẩu tối thiểu 6 ký tự</small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmNewPassword" class="form-label text-white">Xác nhận mật khẩu mới</label>
                            <input type="password" class="form-control auth-input" id="confirmNewPassword" name="ConfirmPassword" required placeholder="Nhập lại mật khẩu">
                        </div>

                        <button type="submit" class="btn btn-success w-100 mb-3 auth-btn">
                            <span id="resetBtnText">Đặt lại mật khẩu</span>
                            <span id="resetLoader" class="spinner-border spinner-border-sm d-none ms-2"></span>
                        </button>
                    </form>

                    <div class="text-center">
                        <a href="#" id="backToLoginFromReset" class="text-muted">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>

                <!-- ============= EMAIL VERIFICATION SENT MESSAGE ============= -->
                <div id="emailVerificationSent" class="d-none text-center">
                    <i class="bi bi-envelope-check text-info" style="font-size: 4rem;"></i>
                    <h4 class="text-white mt-3">Xác nhận email của bạn</h4>
                    <p class="text-muted">Chúng tôi đã gửi liên kết xác thực đến địa chỉ email:</p>
                    <p class="text-light fw-bold mb-3" id="verificationEmailDisplay"></p>
                    <p class="text-muted"><small>Vui lòng kiểm tra hộp thư đến (bao gồm cả thư rác/spam) và nhấp vào liên kết để kích hoạt tài khoản.</small></p>
                    
                    <button id="resendVerificationFromSent" class="btn btn-outline-light w-100 mb-3 auth-btn d-flex align-items-center justify-content-center">
                        <span id="resendText">Gửi lại email xác thực</span>
                        <span id="resendLoader" class="spinner-border spinner-border-sm d-none ms-2"></span>
                    </button>
                    
                    <div id="resendCooldownText" class="text-muted d-none mb-3">
                        Có thể gửi lại sau <span id="cooldownSeconds" class="fw-bold text-warning">30</span> giây
                    </div>
                    
                    <button id="backToLoginFromSent" class="btn btn-primary w-100 auth-btn">
                        Quay lại Đăng nhập
                    </button>
                </div>

                <!-- ============= VERIFICATION SUCCESS MESSAGE ============= -->
                <div id="verificationSuccess" class="d-none text-center">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h4 class="text-white mt-3">Xác thực thành công!</h4>
                    <p class="text-muted">Email của bạn đã được xác thực. Bạn có thể đăng nhập ngay bây giờ.</p>
                    <button id="goToLoginFromVerification" class="btn btn-primary auth-btn">
                        Đăng nhập ngay
                    </button>
                </div>

                <!-- Alert Container -->
                <div id="authAlert" class="alert d-none mt-3" role="alert"></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/auth.css" rel="stylesheet" />
}