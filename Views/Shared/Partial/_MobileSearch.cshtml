<!-- Mobile Search Overlay -->
<div id="mobileSearchOverlay" class="mobile-search-overlay d-lg-none">
    <div class="mobile-search-container">
        <button class="mobile-search-close" id="mobileSearchClose">
            <i class="fas fa-times"></i>
        </button>
        <form action="/tim-kiem" method="get" class="mobile-search-form">
            <div class="mobile-search-input-wrapper">
                <input type="search" name="keyword" placeholder="Tìm kiếm phim..." id="mobileSearchInput"
                    autocomplete="off">
                <button type="submit" class="mobile-search-submit">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>

        <!-- Search suggestions -->
        <div class="mobile-search-suggestions">
            <div class="suggestion-title">Tìm kiếm phổ biến</div>
            <div class="suggestion-tags">
                <span class="suggestion-tag">Phim hành động</span>
                <span class="suggestion-tag">Phim tình cảm</span>
                <span class="suggestion-tag">Phim kinh dị</span>
                <span class="suggestion-tag">Anime</span>
            </div>
        </div>
    </div>
</div>