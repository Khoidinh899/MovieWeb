@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin MoonPhim</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" /> 
    <link rel="stylesheet" href="~/admin/admin_layout.css">
    <link rel="stylesheet" href="~/admin/admin_responsive_main.css">
    <link rel="stylesheet" href="~/admin/admin_responsive_movies.css">
    <link rel="stylesheet" href="~/admin/admin_responsive_user_detail.css">
    <link rel="stylesheet" href="~/admin/admin_responsive_movie_requests.css"> 
    <link rel="stylesheet" href="~/admin/admin_print.css" media="print">
    <link rel="stylesheet" href="~/css/notification.css" />
    <link rel="stylesheet" href="~/css/chatbot.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="admin-page d-flex flex-column min-vh-100">

    @{
        var token = antiforgery.GetAndStoreTokens(Context).RequestToken;
    }
    <input type="hidden" id="RequestVerificationToken" value="@token" />

    @await Html.PartialAsync("Partial/_Header")

    <main role="main" class="admin-container flex-fill">
        @RenderBody()
    </main>

    @await Html.PartialAsync("Partial/_Footer")
    @await Html.PartialAsync("Partial/_Scripts")

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Remove "Admin System" text
            const navbar = document.querySelector('.navbar-custom');
            if (navbar) {
                const walker = document.createTreeWalker(navbar, NodeFilter.SHOW_TEXT);
                let node;
                while (node = walker.nextNode()) {
                    if (node.textContent.trim() === 'Admin System') {
                        node.parentElement.remove();
                    }
                }
            }
        });
    </script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
</body>

</html>