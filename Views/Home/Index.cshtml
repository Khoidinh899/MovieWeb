@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "MoonPhim - Bay bổng cùng điện ảnh";
    
    // 1. Chuẩn bị Mô tả (Lấy từ text bạn đã viết)
    var seoDescription = "Với sự bùng nổ của các nền tảng phát trực tuyến phim, MoonPhim nổi bật lên như một trang web xem phim miễn phí uy tín, mang đến cho người dùng trải nghiệm xem phim tuyệt vời nhất.";
    
    // 2. Chuẩn bị Ảnh (Image) và URL
    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}"; // Ví dụ: https://localhost:5000
    var seoUrl = $"{baseUrl}{request.Path}"; // URL đầy đủ của trang
    var seoImage = $"{baseUrl}/images/iconmoon.png"; // Ảnh logo (phải là URL tuyệt đối)

}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    @* Sửa lại để dùng ViewData["Title"] cho nhất quán *@
    <title>@ViewData["Title"]</title> 
    
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    @* --- BẮT ĐẦU KHỐI SEO --- *@
    <meta name="description" content="@seoDescription" />
    <meta name="keywords" content="xem phim, xem phim miễn phí, xem phim online, phim HD, phim chất lượng cao, moonphim, bay bổng cùng điện ảnh" />

    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@seoUrl" />
    <meta property="og:image" content="@seoImage" />
    <meta property="og:site_name" content="MoonPhim" />
    @* --- KẾT THÚC KHỐI SEO --- *@

    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <div class="bg-animation">
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="circle"></div>
    </div>

    <div class="stars" id="stars"></div>

    <div class="landing-container">
        <div class="logo-container">
            <div class="logo-wrapper">
                <img src="~/images/iconmoon.png" alt="MoonPhim Logo" class="logo">
                <div class="brand-text">
                    <div class="brand-name">MoonPhim</div>
                    <div class="brand-slogan">Bay bổng cùng điện ảnh</div>
                </div>
            </div>
        </div>

        <h1 class="main-heading">
            Xem Phim Miễn Phí Chất Lượng Cao
        </h1>
        
        <p class="sub-heading">
            Hàng Nghìn Bộ Phim HD Cập Nhật Liên Tục
        </p>

        <a href="/trang-chu" class="cta-button">
            <span>Xem Ngay</span>
            <span class="arrow">→</span>
        </a>

        <div class="description">
            Trong kỷ nguyên số ngày nay, việc xem phim miễn phí trực tuyến đã trở thành nhu cầu giải trí không thể thiếu. 
            Với sự bùng nổ của các nền tảng phát trực tuyến phim, MoonPhim nổi bật lên như một trang web xem phim miễn phí uy tín, 
            mang đến cho người dùng trải nghiệm xem phim tuyệt vời nhất.
        </div>
    </div>

    <script>
        // Tạo stars
        const starsContainer = document.getElementById('stars');
        for (let i = 0; i < 100; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            const size = Math.random() * 2 + 1;
            star.style.width = size + 'px';
            star.style.height = size + 'px';
            star.style.left = Math.random() * 100 + '%';
            star.style.top = Math.random() * 100 + '%';
            star.style.animationDelay = Math.random() * 3 + 's';
            starsContainer.appendChild(star);
        }
    </script>
</body>
</html>