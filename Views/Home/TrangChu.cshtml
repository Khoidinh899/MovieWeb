        @if (Model.TrendingMovies != null && Model.TrendingMovies.Any())
        {
            var top10List = Model.TrendingMovies.Take(10).ToList();
            <section class="top10-neon-section mb-5 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="section-title">
                        <i class="fas fa-fire text-danger"></i> Phim Trending
                    </h2>
                    <a href="/phim-trending" class="btn btn-outline-primary">Xem tất cả</a>
                </div>

                <!-- Curved Elip Carousel & Infinite Drag Container -->
                <div class="top10-slider-wrapper position-relative" id="top10Wrapper">
                    <div class="top10-track d-flex" id="top10Track">
                        @* Render 3 chu kỳ lặp (Cycle 0, 1, 2) để tạo hiệu ứng Infinite Loop vô tận cực mượt *@
                        @for (int cycle = 0; cycle < 3; cycle++)
                        {
                            for (int i = 0; i < top10List.Count; i++)
                            {
                                var movie = top10List[i];
                                var posterUrl = GetMoviePosterUrl(movie);
                                int rank = i + 1;
                                string rankStrokeClass = rank == 1 ? "rank-neon-gold" : rank == 2 ? "rank-neon-silver" : rank == 3 ? "rank-neon-bronze" : "rank-neon-blue";
                                
                                var isSeries = movie.Type == "series" || (!string.IsNullOrEmpty(movie.EpisodeTotal) && movie.EpisodeTotal != "1");
                                string statusBadge = "";
                                if (!isSeries)
                                {
                                    statusBadge = !string.IsNullOrEmpty(movie.Time) ? movie.Time : "Full";
                                }
                                else
                                {
                                    var epCurrent = movie.EpisodeCurrent ?? "";
                                    if (epCurrent.Contains("Hoàn tất", StringComparison.OrdinalIgnoreCase) || 
                                        epCurrent.Contains("Hoàn Tất", StringComparison.OrdinalIgnoreCase) || 
                                        epCurrent.Contains("Full", StringComparison.OrdinalIgnoreCase) ||
                                        epCurrent.Contains("/", StringComparison.OrdinalIgnoreCase))
                                    {
                                        statusBadge = epCurrent;
                                    }
                                    else
                                    {
                                        var totalStr = !string.IsNullOrEmpty(movie.EpisodeTotal) ? $"/{movie.EpisodeTotal}" : "";
                                        statusBadge = string.IsNullOrEmpty(epCurrent) ? (totalStr.TrimStart('/')) : (epCurrent + totalStr);
                                        if (string.IsNullOrEmpty(statusBadge)) statusBadge = "Đang cập nhật";
                                    }
                                }

                                <div class="top10-item" data-cycle="@cycle" data-index="@i">
                                    <a href="/phim/@movie.Slug" class="top10-link text-decoration-none">
