                                            <!-- Số thứ hạng Neon 3D khổng lồ (Không bị cắt mép) -->
                                            <div class="top10-rank-number @rankStrokeClass">
                                                @rank
                                            </div>

                                            <!-- Khung Poster Dọc -->
                                            <div class="top10-poster-box">
                                                <img src="@posterUrl" alt="@movie.Name" class="top10-img" loading="lazy" decoding="async"
                                                     onerror="this.onerror=null; this.src='/images/default-poster.jpg';">
                                                
                                                <!-- Badge lượt xem ở góc trên bên trái -->
                                                <div class="top10-views-badge">
                                                    <i class="bi bi-eye-fill me-1"></i>@FormatViews(movie.ViewCount)
                                                </div>

                                                <!-- Quality Badge ở góc trên bên phải đối xứng -->
                                                @if (!string.IsNullOrEmpty(movie.Quality))
                                                {
                                                    <div class="top10-quality-badge">
                                                        @movie.Quality
                                                    </div>
                                                }

                                                <!-- Play Button Overlay -->
                                                <div class="top10-overlay">
                                                    <div class="top10-play-btn">
                                                        <i class="fas fa-play"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Movie Info -->
                                            <div class="top10-info mt-2">
                                                <h6 class="top10-title text-truncate mb-1" title="@movie.Name">
                                                    @movie.Name
                                                </h6>
                                                <div class="d-flex justify-content-between align-items-center text-white-50 small">
                                                    <span>@(movie.Year?.ToString() ?? "2026")</span>
                                                    <span class="badge bg-secondary text-white">@statusBadge</span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </section>
        }
    </div>
@section Styles {
    @* --- BẮT ĐẦU KHỐI SEO (Hiển thị trong <head>) --- *@

        <meta name="description" content="@seoDescription" />

        <meta name="keywords"
            content="xem phim, xem phim online, phim hay, phim mới, moonphim, phim vietsub, phim thuyết minh, phim bộ, phim lẻ" />

        <meta property="og:title" content="@ViewData["Title"]" />
        <meta property="og:description" content="@seoDescription" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@seoUrl" />
        <meta property="og:image" content="@seoImage" />
        <meta property="og:site_name" content="MoonPhim" />

    @* --- KẾT THÚC KHỐI SEO --- *@

    <style>
        /* ========================================================
           TOP 10 TRENDING ELIP & INFINITE CAROUSEL STYLES
           ======================================================== */
        .top10-neon-section {
            position: relative;
            padding: 5px 0 25px 0;
            overflow: visible;
        }

        .top10-slider-wrapper {
            position: relative;
            perspective: 1200px;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            cursor: grab;
            cursor: -webkit-grab;
            padding: 10px 0;
        }

        .top10-slider-wrapper.is-dragging {
            cursor: grabbing;
            cursor: -webkit-grabbing;
        }

        .top10-track {
            display: flex;
            gap: 24px;
            overflow-x: auto;
            scroll-behavior: auto;
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
            padding: 20px 25px 30px 25px;
            align-items: center;
        }

        .top10-track::-webkit-scrollbar {
            display: none !important;
        }

        .top10-item {
            flex: 0 0 210px;
            max-width: 225px;
            scroll-snap-align: center;
            will-change: transform, opacity;
            transition: transform 0.25s ease, opacity 0.25s ease;
        }

        @@media (max-width: 992px) {
            .top10-item {
                flex: 0 0 38vw;
                min-width: 175px;
                max-width: 220px;
            }
            .top10-track {
                gap: 16px;
                padding: 15px 15px 25px 20px;
            }
        }

        @@media (max-width: 576px) {
            .top10-item {
                flex: 0 0 68vw;
                min-width: 215px;
                max-width: 270px;
            }
            .top10-track {
                gap: 14px;
                padding: 10px 10px 20px 16px;
            }
        }

        .top10-card {
            position: relative;
            padding-left: 20px;
            transform-origin: center center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Số thứ hạng Neon 3D khổng lồ (Không bị cắt mép) */
        .top10-rank-number {
            position: absolute;
            left: -4px;
            bottom: 30px;
            z-index: 7;
            font-size: 4.8rem;
            font-weight: 900;
            line-height: 1;
            font-family: 'Impact', 'Arial Black', sans-serif;
            user-select: none;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        @@media (max-width: 576px) {
            .top10-rank-number {
                font-size: 4rem;
                left: -2px;
                bottom: 26px;
            }
        }

        .rank-neon-gold {
            color: #050b14;
            -webkit-text-stroke: 2.5px #facc15;
            text-shadow: 0 0 15px rgba(250, 204, 21, 0.85), 0 0 30px rgba(234, 179, 8, 0.55);
        }

        .rank-neon-silver {
            color: #050b14;
            -webkit-text-stroke: 2.5px #e2e8f0;
            text-shadow: 0 0 15px rgba(226, 232, 240, 0.85), 0 0 25px rgba(148, 163, 184, 0.55);
        }

        .rank-neon-bronze {
            color: #050b14;
            -webkit-text-stroke: 2.5px #fb923c;
            text-shadow: 0 0 15px rgba(251, 146, 60, 0.85), 0 0 25px rgba(234, 88, 12, 0.55);
        }

        .rank-neon-blue {
            color: #050b14;
            -webkit-text-stroke: 2px #38bdf8;
            text-shadow: 0 0 12px rgba(56, 189, 248, 0.75);
        }

        .top10-poster-box {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 2/3;
            background: #111827;
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
            transition: all 0.3s ease;
        }

        .top10-item:hover .top10-poster-box {
            border-color: rgba(250, 204, 21, 0.8);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 20px rgba(250, 204, 21, 0.35);
        }

        .top10-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
            pointer-events: none;
        }

        .top10-item:hover .top10-img {
            transform: scale(1.05);
        }

        /* Lượt xem góc trên bên trái */
        .top10-views-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            z-index: 6;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            color: #facc15;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 6px;
            border: 1px solid rgba(250, 204, 21, 0.3);
        }

        /* Quality badge góc trên bên phải đối xứng */
        .top10-quality-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 6;
            background: rgba(239, 68, 68, 0.85);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .top10-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .top10-item:hover .top10-overlay {
            opacity: 1;
        }

        .top10-play-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #facc15 0%, #f97316 100%);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 0 20px rgba(250, 204, 21, 0.8);
            transform: scale(0.8);
            transition: transform 0.3s ease;
        }

        .top10-item:hover .top10-play-btn {
            transform: scale(1);
        }

        .top10-title {
            color: #fff;
            font-weight: 700;
            font-size: 0.92rem;
            transition: color 0.2s ease;
        }

        .top10-item:hover .top10-title {
            color: #facc15;
        }
    </style>
}

@section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const shouldShowAds = @Json.Serialize(ViewBag.ShouldShowAds ?? true);

                // Hàm gọi API để lấy quảng cáo Pop-up
                async function fetchPopupAd() {
                    if (!shouldShowAds) {
                    @* console.log('User is Premium/Admin, skipping popup ad.'); *@
                    return; 
                }
                    try {
                        const response = await fetch('/api/ads/get-placements?placements=HomePage_Popup');

                        if (!response.ok) {
                            console.error('Lỗi API (Popup Ad):', response.statusText);
                            return;
                        }

                        const banners = await response.json();

                        if (banners && banners.length > 0) {
                            const banner = banners[0];

                            const modalHtml = createAdModalHtml(banner);

                            document.body.insertAdjacentHTML('beforeend', modalHtml);

                            var adModalElement = document.getElementById('homeAdModal');
                            if (adModalElement) {
                                var adModal = new bootstrap.Modal(adModalElement);
                                adModal.show();

                                adModalElement.addEventListener('hidden.bs.modal', function () {
                                    adModalElement.remove();
                                });
                            }
                        }
                    } catch (error) {
                        console.error('Lỗi khi tải popup ad:', error);
                    }
                }

                function createAdModalHtml(banner) {
                    let closeButtonCss = `
                    position: absolute; 
                    top: -15px; 
                    right: -10px; 
                    background-color: white; 
                    border-radius: 50%; 
                    opacity: 1; 
                    box-shadow: 0 0 10px rgba(0,0,0,0.5);
                    width: 30px;
                    height: 30px;
                    padding: 0;
                `;
                    return `
                <div class="modal fade" id="homeAdModal" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content" style="background-color: transparent; border: none;">
                      <div class="modal-body" style="padding: 0; position: relative;">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" 
                                aria-label="Close" style="${closeButtonCss}"></button>
                        <a href="${banner.clickUrl}" target="_blank" rel="noopener noreferrer">
                            <img src="${banner.adContentUrl}" class="img-fluid rounded" alt="${banner.adName}">
                        </a>
                      </div>
                    </div>
                  </div>
                </div>`;
                }

                fetchPopupAd();

                // ===== TOP 10 TRENDING ELIP & INFINITE DRAG CAROUSEL =====
                const wrapper = document.getElementById('top10Wrapper');
                const track = document.getElementById('top10Track');

                if (track && wrapper) {
                    let isDown = false;
                    let startX = 0;
                    let scrollLeft = 0;
                    let isDragging = false;
                    let dragDistance = 0;

                    // Tính độ rộng 1 chu kỳ 10 phim (cycle)
                    function getSingleCycleWidth() {
                        const cycleItems = track.querySelectorAll('.top10-item[data-cycle="0"]');
                        if (cycleItems.length === 0) return 0;
                        let w = 0;
                        cycleItems.forEach(item => {
                            w += item.offsetWidth + (window.innerWidth <= 576 ? 14 : (window.innerWidth <= 992 ? 16 : 24));
                        });
                        return w;
                    }

                    // Cuộn về chu kỳ giữa (Cycle 1) khi khởi tạo
                    function initInitialScroll() {
                        const singleW = getSingleCycleWidth();
                        if (singleW > 0) {
                            track.scrollLeft = singleW;
                        }
                        updateCurvedElip();
                    }

                    // Hiệu ứng Elip / 3D Curve cho các thẻ
                    function updateCurvedElip() {
                        const trackRect = track.getBoundingClientRect();
                        const trackCenter = trackRect.left + trackRect.width / 2;
                        const items = track.querySelectorAll('.top10-item');

                        items.forEach(item => {
                            const itemRect = item.getBoundingClientRect();
                            const itemCenter = itemRect.left + itemRect.width / 2;
                            const normalizedDist = (itemCenter - trackCenter) / (trackRect.width / 2);
                            const absDist = Math.min(Math.abs(normalizedDist), 2);

                            const scale = Math.max(0.88, 1.04 - absDist * 0.12);
                            const opacity = Math.max(0.72, 1 - absDist * 0.22);
                            const rotateY = normalizedDist * -8;
                            const translateY = absDist * absDist * 6;

                            const card = item.querySelector('.top10-card');
                            if (card) {
                                card.style.transform = `perspective(900px) translateY(${translateY}px) rotateY(${rotateY}deg) scale(${scale})`;
                                card.style.opacity = opacity;
                            }
                        });
                    }

                    // Sự kiện cuộn vô tận (Infinite Loop Boundary Check)
                    track.addEventListener('scroll', function () {
                        const singleW = getSingleCycleWidth();
                        if (singleW > 0) {
                            if (track.scrollLeft >= singleW * 2) {
                                track.scrollLeft -= singleW;
                            } else if (track.scrollLeft <= 10) {
                                track.scrollLeft += singleW;
                            }
                        }
                        requestAnimationFrame(updateCurvedElip);
                    }, { passive: true });

                    // Chuột kéo (Mouse Drag to scroll trên Desktop)
                    wrapper.addEventListener('mousedown', function (e) {
                        isDown = true;
                        isDragging = false;
                        dragDistance = 0;
                        startX = e.pageX - track.offsetLeft;
                        scrollLeft = track.scrollLeft;
                        wrapper.classList.add('is-dragging');
                    });

                    window.addEventListener('mouseup', function () {
                        if (!isDown) return;
                        isDown = false;
                        wrapper.classList.remove('is-dragging');
                        setTimeout(() => { isDragging = false; dragDistance = 0; }, 50);
                    });

                    wrapper.addEventListener('mousemove', function (e) {
                        if (!isDown) return;
                        e.preventDefault();
                        const x = e.pageX - track.offsetLeft;
                        const walk = (x - startX) * 1.35;
                        track.scrollLeft = scrollLeft - walk;
                        dragDistance = Math.abs(x - startX);
                        if (dragDistance > 6) {
                            isDragging = true;
                        }
                    });

                    // Chặn mở link nếu người dùng đang thực hiện động tác rê chuột
                    track.querySelectorAll('.top10-link').forEach(link => {
                        link.addEventListener('click', function (e) {
                            if (isDragging || dragDistance > 6) {
                                e.preventDefault();
                                e.stopPropagation();
                            }
                        });
                    });

                    // Khởi tạo vị trí ban đầu
                    setTimeout(initInitialScroll, 100);
                    window.addEventListener('resize', updateCurvedElip);
                }
            });
        </script>
}