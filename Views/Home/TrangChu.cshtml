                                            <div class="top10-overlay">
                                                <div class="top10-play-btn">
                                                    <i class="fas fa-play"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Movie Info -->
                                        <div class="top10-info mt-2">
                                            <h6 class="top10-title text-truncate mb-0" title="@movie.Name">
                                                @movie.Name
                                            </h6>
                                            <div class="d-flex justify-content-between align-items-center text-white-50 small mt-1">
                                                <span>@(movie.Year?.ToString() ?? "2026")</span>
                                                <span class="text-warning fw-bold"><i class="bi bi-fire"></i> Top #@rank</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>

                    <button type="button" class="top10-nav-btn top10-next" id="top10NextBtn" aria-label="Lướt sang phải">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </section>
        }
    </div>
@section Styles {
    @* --- BẮT ĐẦU KHỐI SEO (Hiển thị trong <head>) --- *@

        <meta name="description" content="@seoDescription" />

        <meta name="keywords"
            content="xem phim, xem phim online, phim hay, phim mới, moonphim, phim vietsub, phim thuyết minh, phim bộ, phim lẻ" />

        <meta property="og:title" content="@ViewData["Title"]" />
        <meta property="og:description" content="@seoDescription" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@seoUrl" />
        <meta property="og:image" content="@seoImage" />
        <meta property="og:site_name" content="MoonPhim" />

    @* --- KẾT THÚC KHỐI SEO --- *@

    <style>
        /* ========================================================
           TOP 10 NEON BILLBOARD STYLES (MOONPHIM BRANDING)
           ======================================================== */
        .top10-neon-section {
            position: relative;
            padding: 10px 0 20px 0;
        }

        .text-neon-gold {
            font-size: 1.45rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff 0%, #facc15 50%, #f97316 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 0.5px;
            text-shadow: 0 0 25px rgba(250, 204, 21, 0.3);
        }

        .fire-icon-pulse {
            animation: firePulse 1.8s infinite alternate;
        }

        @@keyframes firePulse {
            0% { transform: scale(1); filter: drop-shadow(0 0 5px rgba(239, 68, 68, 0.6)); }
            100% { transform: scale(1.2); filter: drop-shadow(0 0 15px rgba(250, 204, 21, 0.9)); }
        }

        .btn-view-all-trending {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: #facc15;
            font-weight: 700;
            font-size: 0.92rem;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 20px;
            background: rgba(250, 204, 21, 0.1);
            border: 1px solid rgba(250, 204, 21, 0.3);
            transition: all 0.3s ease;
        }

        .btn-view-all-trending:hover {
            background: linear-gradient(135deg, #facc15 0%, #f97316 100%);
            color: #000;
            box-shadow: 0 4px 15px rgba(250, 204, 21, 0.4);
            transform: translateX(3px);
        }

        .top10-slider-wrapper {
            position: relative;
        }

        .top10-track {
            overflow-x: auto;
            scroll-behavior: smooth;
            scrollbar-width: none;
            -ms-overflow-style: none;
            padding-bottom: 12px;
        }

        .top10-track::-webkit-scrollbar {
            display: none;
        }

        .top10-item {
            flex: 0 0 calc(18% - 12px);
            min-width: 175px;
            max-width: 220px;
            scroll-snap-align: start;
        }

        @@media (max-width: 992px) {
            .top10-item {
                flex: 0 0 calc(30% - 10px);
                min-width: 155px;
            }
        }

        @@media (max-width: 576px) {
            .top10-item {
                flex: 0 0 calc(46% - 8px);
                min-width: 140px;
            }
            .text-neon-gold {
                font-size: 1.15rem;
            }
        }

        .top10-card {
            position: relative;
            padding-left: 28px;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .top10-card:hover {
            transform: translateY(-8px);
        }

        .top10-rank-number {
            position: absolute;
            left: -12px;
            bottom: 35px;
            z-index: 5;
            font-size: 4.8rem;
            font-weight: 900;
            line-height: 1;
            font-family: 'Impact', 'Arial Black', sans-serif;
            user-select: none;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .top10-card:hover .top10-rank-number {
            transform: scale(1.1) translateX(-4px);
        }

        .rank-neon-gold {
            color: #050b14;
            -webkit-text-stroke: 2.5px #facc15;
            text-shadow: 0 0 15px rgba(250, 204, 21, 0.8), 0 0 30px rgba(234, 179, 8, 0.5);
        }

        .rank-neon-silver {
            color: #050b14;
            -webkit-text-stroke: 2.5px #e2e8f0;
            text-shadow: 0 0 15px rgba(226, 232, 240, 0.8), 0 0 25px rgba(148, 163, 184, 0.5);
        }

        .rank-neon-bronze {
            color: #050b14;
            -webkit-text-stroke: 2.5px #fb923c;
            text-shadow: 0 0 15px rgba(251, 146, 60, 0.8), 0 0 25px rgba(234, 88, 12, 0.5);
        }

        .rank-neon-blue {
            color: #050b14;
            -webkit-text-stroke: 2px #38bdf8;
            text-shadow: 0 0 12px rgba(56, 189, 248, 0.7);
        }

        .top10-poster-box {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 2/3;
            background: #111827;
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
            transition: all 0.3s ease;
        }

        .top10-card:hover .top10-poster-box {
            border-color: rgba(250, 204, 21, 0.8);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 20px rgba(250, 204, 21, 0.35);
        }

        .top10-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .top10-card:hover .top10-img {
            transform: scale(1.06);
        }

        .top10-views-badge {
            position: absolute;
            bottom: 8px;
            right: 8px;
            z-index: 6;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            color: #facc15;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 6px;
            border: 1px solid rgba(250, 204, 21, 0.3);
        }

        .top10-quality-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 6;
            background: rgba(239, 68, 68, 0.85);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .top10-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .top10-card:hover .top10-overlay {
            opacity: 1;
        }

        .top10-play-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #facc15 0%, #f97316 100%);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 0 20px rgba(250, 204, 21, 0.8);
            transform: scale(0.8);
            transition: transform 0.3s ease;
        }

        .top10-card:hover .top10-play-btn {
            transform: scale(1);
        }

        .top10-title {
            color: #fff;
            font-weight: 700;
            font-size: 0.92rem;
            transition: color 0.2s ease;
        }

        .top10-card:hover .top10-title {
            color: #facc15;
        }

        .top10-nav-btn {
            position: absolute;
            top: 42%;
            transform: translateY(-50%);
            z-index: 20;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(250, 204, 21, 0.4);
            color: #facc15;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
            transition: all 0.25s ease;
        }

        .top10-nav-btn:hover {
            background: #facc15;
            color: #000;
            transform: translateY(-50%) scale(1.15);
            box-shadow: 0 0 20px rgba(250, 204, 21, 0.8);
        }

        .top10-prev {
            left: -15px;
        }

        .top10-next {
            right: -15px;
        }

        @@media (max-width: 768px) {
            .top10-nav-btn {
                display: none !important;
            }
            .top10-card {
                padding-left: 20px;
            }
            .top10-rank-number {
                font-size: 3.6rem;
                left: -8px;
            }
        }
    </style>
}

@section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const shouldShowAds = @Json.Serialize(ViewBag.ShouldShowAds ?? true);

                // Hàm gọi API để lấy quảng cáo Pop-up
                async function fetchPopupAd() {
                    if (!shouldShowAds) {
                    @* console.log('User is Premium/Admin, skipping popup ad.'); *@
                    return; 
                }
                    try {
                        const response = await fetch('/api/ads/get-placements?placements=HomePage_Popup');

                        if (!response.ok) {
                            console.error('Lỗi API (Popup Ad):', response.statusText);
                            return;
                        }

                        const banners = await response.json();

                        if (banners && banners.length > 0) {
                            const banner = banners[0];

                            // 3. Tạo HTML cho Modal
                            const modalHtml = createAdModalHtml(banner);

                            document.body.insertAdjacentHTML('beforeend', modalHtml);

                            var adModalElement = document.getElementById('homeAdModal');
                            if (adModalElement) {
                                var adModal = new bootstrap.Modal(adModalElement);
                                adModal.show();

                                adModalElement.addEventListener('hidden.bs.modal', function () {
                                    adModalElement.remove();
                                });
                            }
                        }
                    } catch (error) {
                        console.error('Lỗi khi tải popup ad:', error);
                    }
                }

                // Hàm trợ giúp: Tạo chuỗi HTML cho Bootstrap 5 Modal
                function createAdModalHtml(banner) {

                    let closeButtonCss = `
                    position: absolute; 
                    top: -15px; 
                    right: -10px; 
                    background-color: white; 
                    border-radius: 50%; 
                    opacity: 1; 
                    box-shadow: 0 0 10px rgba(0,0,0,0.5);
                    width: 30px;
                    height: 30px;
                    padding: 0;
                `;

                    // =============================================
                    // 📢 SỬA LỖI Ở ĐÂY
                    // Đã đổi "banner.imageUrl" thành "banner.adContentUrl"
                    // Và "banner.clickUrl" (đã đúng từ trước)
                    // =============================================
                    return `
                <div class="modal fade" id="homeAdModal" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content" style="background-color: transparent; border: none;">
                  
                      <div class="modal-body" style="padding: 0; position: relative;">
                    
                        <button type="button" class="btn-close" data-bs-dismiss="modal" 
                                aria-label="Close" style="${closeButtonCss}"></button>

                        <a href="${banner.clickUrl}" target="_blank" rel="noopener noreferrer">
                            <img src="${banner.adContentUrl}" class="img-fluid rounded" alt="${banner.adName}">
                        </a>
                      </div>

                    </div>
                  </div>
                </div>`;
                }

                // Chạy hàm chính!
                fetchPopupAd();

                // ===== TOP 10 TRENDING SLIDER SCRIPT =====
                const track = document.getElementById('top10Track');
                const prevBtn = document.getElementById('top10PrevBtn');
                const nextBtn = document.getElementById('top10NextBtn');

                if (track && prevBtn && nextBtn) {
                    const scrollAmount = 350;
                    prevBtn.addEventListener('click', function () {
                        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    });
                    nextBtn.addEventListener('click', function () {
                        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    });
                }
            });
        </script>
}