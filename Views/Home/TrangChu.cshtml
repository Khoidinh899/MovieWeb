        @if (Model.TrendingMovies != null && Model.TrendingMovies.Any())
        {
            <section class="top10-neon-section mb-5 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="fire-icon-pulse">
                            <i class="bi bi-fire text-danger fs-3"></i>
                        </div>
                        <h2 class="section-title text-neon-gold mb-0">
                            TOP 10 PHIM TRENDING TRÊN MOONPHIM
                        </h2>
                    </div>
                    <a href="/phim-trending" class="btn-view-all-trending">
                        <span>Xem tất cả</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </a>
                </div>

                <!-- Slider Container with Left / Right Navigation -->
                <div class="top10-slider-wrapper position-relative">
                    <button type="button" class="top10-nav-btn top10-prev" id="top10PrevBtn" aria-label="Lướt sang trái">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    
                    <div class="top10-track d-flex gap-3 gap-md-4 py-2" id="top10Track">
                        @for (int i = 0; i < Model.TrendingMovies.Count && i < 10; i++)
                        {
                            var movie = Model.TrendingMovies[i];
                            var posterUrl = GetMoviePosterUrl(movie);
                            int rank = i + 1;
                            string rankStrokeClass = rank == 1 ? "rank-neon-gold" : rank == 2 ? "rank-neon-silver" : rank == 3 ? "rank-neon-bronze" : "rank-neon-blue";

                            <div class="top10-item">
                                <a href="/phim/@movie.Slug" class="top10-link text-decoration-none">
                                    <div class="top10-card position-relative">
                                        <!-- Số thứ hạng Neon 3D khổng lồ -->
                                        <div class="top10-rank-number @rankStrokeClass">
                                            @rank
                                        </div>

                                        <!-- Khung Poster Dọc -->
                                        <div class="top10-poster-box">
                                            <img src="@posterUrl" alt="@movie.Name" class="top10-img" loading="lazy" decoding="async"
                                                 onerror="this.onerror=null; this.src='/images/default-poster.jpg';">
                                            
                                            <!-- Badge lượt xem thực tế -->
                                            <div class="top10-views-badge">
                                                <i class="bi bi-eye-fill me-1"></i>@(movie.ViewCount ?? 0)
                                            </div>

