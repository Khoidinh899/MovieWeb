@model IEnumerable<MovieWeb.Models.PaymentHistoryViewModel>

@{
    ViewData["Title"] = "Lịch sử thanh toán";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalTransactions = ViewBag.TotalTransactions ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;

    // Lấy trạng thái hiện tại từ URL để active nút filter (mặc định là all)
    var currentStatus = Context.Request.Query["status"].ToString();
    if (string.IsNullOrEmpty(currentStatus)) currentStatus = "all";

    var startItem = (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalTransactions);
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payment-history.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}

<div class="container py-5 notification-page-container">
    <div class="row">

        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/User/Shared/_ProfileSidebar.cshtml",
            (MovieWeb.Models.DTOs.UserProfileDto)ViewBag.UserProfile)
        </div>

        <div class="col-lg-9">
            <div class="card notification-page-card">

                <div class="card-header notification-page-header">
                    <h4 class="mb-0">
                        <i class="bi bi-credit-card-2-front me-2"></i> @ViewData["Title"]
                    </h4>
                </div>

                <div class="notification-page-filters">
                    <div class="filter-group">
                        <label class="filter-label">Trạng thái:</label>
                        <div class="btn-group" role="group">
                            <a href="/user/payment-history?status=all"
                                class="btn btn-filter @(currentStatus == "all" ? "active" : "")">
                                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Tất cả
                            </a>
                            <a href="/user/payment-history?status=completed"
                                class="btn btn-filter @(currentStatus == "completed" ? "active" : "")">
                                <i class="bi bi-check-circle-fill me-1"></i> Thành công
                            </a>
                            <a href="/user/payment-history?status=cancelled"
                                class="btn btn-filter @(currentStatus == "cancelled" ? "active" : "")">
                                <i class="bi bi-x-circle-fill me-1"></i> Đã hủy
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (!Model.Any() && currentPage == 1)
                    {
                        <div class="empty-state">
                            <i class="bi bi-receipt display-1 text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có giao dịch nào</h5>
                            <p class="text-muted">Bạn chưa thực hiện giao dịch nào với trạng thái này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="payment-table-wrapper">
                            <table class="payment-table">
                                <thead>
                                    <tr>
                                        <th>Mã GD</th>
                                        <th>Gói</th>
                                        <th>Số tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày thanh toán</th>
                                        <th>Ngày hết hạn</th>
                                        <th>Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id="row-@item.SubscriptionId">
                                            <td data-label="Mã GD">
                                                <span class="fw-bold text-primary">#@item.TransactionCode</span>
                                            </td>

                                            <td data-label="Gói">
                                                <span class="badge bg-light text-dark border">@item.PlanName</span>
                                            </td>

                                            <td data-label="Số tiền">
                                                <span class="fw-bold">@item.AmountVND.ToString("N0") ₫</span>
                                            </td>

                                            <td data-label="Trạng thái" id="status-cell-@item.SubscriptionId">
                                                @if (!string.IsNullOrEmpty(item.SubscriptionStatus))
                                                {
                                                    switch (item.SubscriptionStatus)
                                                    {
                                                        case "stacked":
                                                            <span class="status-badge status-stacked"><i
                                                                    class="fas fa-plus-circle me-1"></i> Cộng dồn</span>
                                                            break;
                                                        case "expired":
                                                            <span class="status-badge status-expired"><i class="fas fa-history me-1"></i>
                                                                Hết hạn</span>
                                                            break;
                                                        case "cancelled":
                                                            <span class="status-badge status-cancelled"><i
                                                                    class="fas fa-times-circle me-1"></i> Đã hủy</span>
                                                            break;
                                                        default:
                                                            <span class="status-badge status-@item.Status.ToLower()">
                                                                @if (item.Status.ToLower() == "completed")
                                                                {
                                                                    <i
                                                                        class="fas fa-check-circle me-1"></i>
                                                                }
                                                                @item.StatusDisplay
                                                            </span>
                                                            break;
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-@item.Status.ToLower()">
                                                        @if (item.Status.ToLower() == "completed")
                                                        {
                                                            <i
                                                                class="fas fa-check-circle me-1"></i>
                                                        }
                                                        @item.StatusDisplay
                                                    </span>
                                                }
                                            </td>

                                            <td data-label="Ngày thanh toán">
                                                <span>@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                            </td>

                                            <td data-label="Ngày hết hạn">
                                                @if (item.SubscriptionEndDate.HasValue)
                                                {
                                                    <span>@item.SubscriptionEndDate.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>

                                            <td data-label="Hành động" id="notes-cell-@item.SubscriptionId">
                                                @if (item.Status == "completed" && item.SubscriptionId is not null &&
                                                                                        item.SubscriptionStatus != "cancelled" && item.SubscriptionStatus != "expired" && item.SubscriptionStatus != "stacked" && item.SubscriptionStatus !=
                                                                                        "converted")
                                                {
                                                    <button class="btn btn-sm btn-outline-danger"
                                                        data-subscription-id="@item.SubscriptionId"
                                                        onclick="confirmCancel(this.dataset.subscriptionId)">
                                                        <i class="bi bi-x-lg"></i> Huỷ gói
                                                    </button>
                                                }
                                                else if (item.SubscriptionStatus == "cancelled")
                                                {
                                                    <small class="text-muted fst-italic">Còn hạn đến hết kỳ</small>
                                                }
                                                else if (item.SubscriptionStatus == "stacked" || item.SubscriptionStatus ==
                                                "converted")
                                                {
                                                    <small class="text-success fst-italic">Đã gộp gói</small>
                                                }
                                                else
                                                {
                                                    <!-- TD rỗng nếu không có action nào -->
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPages > 1)
                        {
                            <div class="notification-pagination">
                                @if (currentPage > 1)
                                {
                                    <a href="/user/payment-history?status=@currentStatus&page=@(currentPage - 1)"
                                        class="btn btn-page">
                                        <i class="bi bi-chevron-left"></i> Trước
                                    </a>
                                }

                                <span class="page-info">
                                    Trang <strong>@currentPage</strong> / @totalPages
                                </span>

                                @if (currentPage < totalPages)
                                {
                                    <a href="/user/payment-history?status=@currentStatus&page=@(currentPage + 1)"
                                        class="btn btn-page">
                                        Sau <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div id="confirmOverlay" class="confirm-overlay">
    <div class="confirm-box">
        <h3>⚠️ Xác nhận huỷ gói</h3>
        <p>
            <strong>Lưu ý:</strong><br />
            • Vẫn dùng đến hết hạn<br />
            • Không mất tiền<br />
            • Gói mới sẽ cộng dồn thời gian<br />
            <br />
            Bạn có chắc muốn huỷ không?
        </p>
        <button class="confirm-btn confirm-yes" onclick="cancelConfirmed()">Xác nhận hủy</button>
        <button class="confirm-btn confirm-no" onclick="closeConfirm()">Đóng</button>
    </div>
</div>

@section Scripts {
    <script>
        let cancelSubscriptionId = null;

        function confirmCancel(subscriptionId) {
            if (!subscriptionId || subscriptionId === 'null' || subscriptionId === 'undefined') {
                alert('Lỗi: Không xác định được ID gói đăng ký!');
                return;
            }
            cancelSubscriptionId = String(subscriptionId);
            document.getElementById("confirmOverlay").style.display = "flex";
        }

        function closeConfirm() {
            document.getElementById("confirmOverlay").style.display = "none";
        }

        async function cancelConfirmed() {
            if (!cancelSubscriptionId) {
                alert("Không tìm thấy ID gói cần hủy!");
                return;
            }
            const subscriptionIdToCancel = cancelSubscriptionId;

            try {
                const response = await fetch('/api/subscription/cancel', {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        subscriptionId: parseInt(subscriptionIdToCancel),
                        reason: "User requested cancel",
                        cancelImmediately: false
                    })
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'Lỗi không xác định');
                }

                document.getElementById("confirmOverlay").style.display = "none";

                // Cập nhật UI trực tiếp
                const statusCell = document.getElementById(`status-cell-${subscriptionIdToCancel}`);
                if (statusCell) {
                    statusCell.innerHTML = `<span class="status-badge status-cancelled"><i class="fas fa-times-circle me-1"></i> Đã hủy</span>`;
                }

                const notesCell = document.getElementById(`notes-cell-${subscriptionIdToCancel}`);
                if (notesCell) {
                    notesCell.innerHTML = `<small class="text-muted fst-italic">Còn hạn đến hết kỳ</small>`;
                }

                cancelSubscriptionId = null;

            } catch (err) {
                document.getElementById("confirmOverlay").style.display = "none";
                cancelSubscriptionId = null;
                alert("❌ Lỗi: " + err.message);
            }
        }
    </script>
}