@model List<MovieWeb.Models.DTOs.WatchHistoryMovieDto>

@{
    ViewData["Title"] = "Lịch Sử Xem";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@functions {
    public string GetMoviePosterUrl(string? posterUrl)
    {
        if (string.IsNullOrEmpty(posterUrl))
        {
            return "/images/no-poster.jpg";
        }

        if (posterUrl.StartsWith("http"))
        {
            return posterUrl;
        }

        return "https://img.ophim.live/uploads/movies/" + posterUrl.TrimStart('/');
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="container py-5">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("~/Views/User/Shared/_ProfileSidebar.cshtml", 
                (MovieWeb.Models.DTOs.UserProfileDto)ViewBag.UserProfile)
        </div>

        <div class="col-lg-9">
            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history text-info me-2"></i>Lịch Sử Xem
                        </h5>
                        <p class="text-muted mb-0 small">Danh sách các bộ phim bạn đã xem gần đây</p>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" id="clearAllHistoryBtn">
                            <i class="bi bi-trash"></i> Xóa tất cả
                        </button>
                    }
                </div>

                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clock-history text-muted" style="font-size:4rem;"></i>
                            <h4 class="mt-3">Chưa có lịch sử xem</h4>
                            <p class="text-muted">Bạn chưa xem phim nào. Hãy bắt đầu khám phá ngay!</p>
                            <a href="/trang-chu" class="btn btn-primary mt-3">
                                <i class="bi bi-play-circle me-2"></i> Xem phim ngay
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3" id="historyGrid">
                            @foreach (var item in Model)
                            {
                                <div class="col-md-4 col-sm-6">
                                    <div class="movie-card">
                                        <a href="/phim/@item.Slug">
                                            <div class="movie-poster">
                                                <img src="@GetMoviePosterUrl(item.PosterUrl)"
                                                     alt="@item.Name"
                                                     loading="lazy"
                                                     onerror="this.onerror=null; this.src='/images/no-poster.jpg';">

                                                <div class="watch-progress">
                                                    <div class="progress-bar" style="width:@item.ProgressPercentage%"></div>
                                                </div>
                                            </div>

                                            <div class="movie-info">
                                                <h6 class="movie-title">@item.Name</h6>

                                                <p class="movie-meta">
                                                    @if (item.EpisodeNumber.HasValue)
                                                    {
                                                        <span class="badge bg-info">Tập @item.EpisodeNumber.Value</span>
                                                    }

                                                    @if (item.Year.HasValue)
                                                    {
                                                        <span> • @item.Year.Value</span>
                                                    }

                                                    @if (!string.IsNullOrEmpty(item.Quality))
                                                    {
                                                        <span> • @item.Quality</span>
                                                    }

                                                    <small class="text-muted d-block mt-1">
                                                        @item.LastWatchedAt.ToString("dd/MM/yyyy HH:mm")
                                                    </small>
                                                </p>
                                            </div>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-danger remove-history"
                                                data-history-id="@item.HistoryId"
                                                title="Xóa khỏi lịch sử">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (ViewBag.TotalPages > 1)
                        {
                            <nav class="mt-4">
                                <ul class="pagination justify-content-center">

                                    @if (ViewBag.HasPrevious)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="/user/history?page=@(ViewBag.CurrentPage - 1)">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }

                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="/user/history?page=@i">@i</a>
                                        </li>
                                    }

                                    @if (ViewBag.HasNext)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="/user/history?page=@(ViewBag.CurrentPage + 1)">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/user-history.js" asp-append-version="true"></script>
}
