            document.getElementById('noticeBodyEditor').innerHTML = '<div><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Thời gian dự kiến:</strong> Từ 02:00 đến 04:00 rạng sáng.</div><div class="mt-2"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Sau bảo trì, tốc độ load phim và chất lượng Full HD / 4K sẽ tăng gấp đôi!</div>';
            document.getElementById('ButtonText').value = 'ĐÃ HIỂU & TIẾP TỤC';
        } else if (type === 'newfeatures') {
            document.getElementById('BadgeText').value = '✨ TÍNH NĂNG MỚI RA MẮT ✨';
            document.getElementById('Title').value = '🎬 TRẢI NGHIỆM XEM PHIM HOÀN TOÀN MỚI 🎬';
            document.getElementById('mainMessageEditor').innerHTML = '🎉 <strong>MoonPhim</strong> vừa cập nhật giao diện mới cùng hàng loạt tính năng đỉnh cao phục vụ cộng đồng mê phim!';
            document.getElementById('noticeHeaderEditor').innerHTML = '<i class="bi bi-stars text-warning me-2"></i><strong class="text-white">CÁC ĐIỂM NỔI BẬT VỪA CẬP NHẬT</strong>';
            document.getElementById('noticeBodyEditor').innerHTML = '<div><i class="bi bi-play-circle-fill text-danger me-2"></i>Trình phát Video Player siêu mượt, hỗ trợ cử chỉ vuốt tua trên điện thoại.</div><div class="mt-2"><i class="bi bi-phone-fill text-primary me-2"></i>Ứng dụng App Android & iOS đã có mặt, cài đặt chỉ trong 1 chạm!</div>';
