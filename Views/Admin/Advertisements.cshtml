@model IEnumerable<MovieWeb.Models.Entities.Advertisement>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Quảng Cáo";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-light me-3" title="Quay lại">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 class="mb-0">
                <i class="bi bi-film me-2"></i> @ViewData["Title"]
            </h4>
        </div>
        <div class="text-muted small">
            <i class="bi bi-calendar-event me-1"></i>
            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
    
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <a asp-action="CreateAdvertisement" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm quảng cáo mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="ads-table-wrapper" class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Quảng Cáo</th>
                            <th>Vị trí (Placement)</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="Tên Quảng Cáo">
                                        <strong>@item.AdName</strong>
                                        <small class="d-block text-muted">@item.Description</small>
                                    </td>
                                    <td data-label="Vị trí">
                                        <span class="badge bg-secondary">@item.Placement</span>
                                    </td>
                                    <td data-label="Thứ tự">
                                        @item.DisplayOrder
                                    </td>
                                    <td data-label="Trạng thái">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Đã tắt</span>
                                        }
                                    </td>
                                    <td data-label="Hành động" class="text-end">
                                        <a asp-action="EditAdvertisement" asp-route-id="@item.AdId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-fill"></i> Sửa
                                        </a>
                                        <form asp-action="DeleteAdvertisement" asp-route-id="@item.AdId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa quảng cáo này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash-fill"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                    <p class="mt-3 text-muted">Chưa có quảng cáo nào</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>