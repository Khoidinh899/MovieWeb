@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Subscription";
}

@section Styles {
    <link rel="stylesheet" href="~/admin/admin_revenue.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="mb-0">
                <i class="bi bi-graph-up"></i> Quản Lý Subscription & Doanh Thu
            </h2>
        </div>
        <div class="text-muted">
            <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"
                style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Users Premium</p>
                            <h2 class="mb-0 fw-bold" id="premiumUsers">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </h2>
                            <small class="opacity-75">Đang hoạt động</small>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="bi bi-gem"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"
                style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Tổng Giao Dịch</p>
                            <h2 class="mb-0 fw-bold" id="totalTransactions">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </h2>
                            <small class="opacity-75">Tất cả trạng thái</small>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"
                style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Subscriptions Active</p>
                            <h2 class="mb-0 fw-bold" id="activeSubscriptions">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </h2>
                            <small class="opacity-75">Đang hoạt động</small>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Revenue Filter Card (Full Width) -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg revenue-filter-card">
                <div class="card-header revenue-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <h5 class="mb-0 text-white">
                            <i class="bi bi-currency-dollar me-2"></i>Doanh Thu Chi Tiết
                        </h5>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-light" onclick="filterRevenue('today')">
                                <i class="bi bi-calendar-day"></i> Hôm nay
                            </button>
                            <button type="button" class="btn btn-light" onclick="filterRevenue('week')">
                                <i class="bi bi-calendar-week"></i> Tuần
                            </button>
                            <button type="button" class="btn btn-light active" onclick="filterRevenue('month')">
                                <i class="bi bi-calendar-month"></i> Tháng
                            </button>
                            <button type="button" class="btn btn-light" onclick="filterRevenue('year')">
                                <i class="bi bi-calendar-range"></i> Năm
                            </button>
                            <button type="button" class="btn btn-light" onclick="showCustomDatePicker()">
                                <i class="bi bi-calendar3"></i> Tùy chỉnh
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Total Revenue - FULL WIDTH -->
                        <div class="col-12">
                            <div class="revenue-stat-box-large bg-gradient-primary text-center">
                                <div class="stat-content-large">
                                    <h6>TỔNG DOANH THU</h6>
                                    <h1 id="filterTotalRevenue" class="display-1">
                                        <div class="spinner-border" role="status"></div>
                                    </h1>
                                    <p class="lead mb-0" id="filterPeriod">Tháng này</p>
                                </div>
                                <div class="stat-icon-background">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                            </div>
                        </div>

                        <!-- 3 Stats Cards - Chia đều -->
                        <div class="col-md-4">
                            <div class="revenue-stat-box bg-gradient-success h-100">
                                <div class="stat-icon-large">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>THÀNH CÔNG</h6>
                                    <h2 id="filterCompletedCount">0</h2>
                                    <small class="text-muted">giao dịch</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="revenue-stat-box bg-gradient-warning h-100">
                                <div class="stat-icon-large">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>ĐANG XỬ LÝ</h6>
                                    <h2 id="filterPendingCount">0</h2>
                                    <small class="text-muted">giao dịch</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="revenue-stat-box bg-gradient-danger h-100">
                                <div class="stat-icon-large">
                                    <i class="bi bi-x-circle-fill"></i>
                                </div>
                                <div class="stat-content">
                                    <h6>THẤT BẠI</h6>
                                    <h2 id="filterFailedCount">0</h2>
                                    <small class="text-muted">giao dịch</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Custom Date Range Modal -->
    <div class="modal fade" id="customDateModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-calendar-range me-2"></i>Chọn Khoảng Thời Gian
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Từ ngày</label>
                        <input type="date" class="form-control" id="customStartDate">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" class="form-control" id="customEndDate">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="applyCustomDateFilter()">
                        <i class="bi bi-check2"></i> Áp dụng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>Biểu Đồ Doanh Thu 30 Ngày
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="80"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-pie-chart me-2"></i>Doanh Thu Theo Gói
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="planRevenueChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="row">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Giao Dịch Gần Đây
                    </h5>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active"
                            onclick="filterTransactions('all')">
                            Tất cả
                        </button>
                        <button type="button" class="btn btn-outline-success" onclick="filterTransactions('completed')">
                            Thành công
                        </button>
                        <button type="button" class="btn btn-outline-warning" onclick="filterTransactions('pending')">
                            Đang xử lý
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="filterTransactions('failed')">
                            Thất bại
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="recentTransactionsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã GD</th>
                                    <th>User</th>
                                    <th>Gói</th>
                                    <th>Số Tiền</th>
                                    <th>Phương Thức</th>
                                    <th>Trạng Thái</th>
                                    <th>Ngày</th>
                                    <th>Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <div class="spinner-border spinner-border-sm me-2" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        Đang tải dữ liệu...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted">
                            <small>Hiển thị <span id="showingCount">0</span> trên tổng số <span id="totalCount">0</span>
                                giao dịch</small>
                        </div>
                        <div id="paginationControls">
                            <!-- Pagination will be added here by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin-revenue.js" asp-append-version="true"></script>
}