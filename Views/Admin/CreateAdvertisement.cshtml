@model MovieWeb.Models.Entities.Advertisement
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Quảng Cáo Mới";
}
@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        <h5>Chi tiết lỗi:</h5>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
                @if (error.Exception != null)
                {
                    <li><strong>Exception:</strong> @error.Exception.Message</li>
                }
            }
        </ul>
    </div>
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header">
                    <h5 class="mb-0">Thông tin Quảng cáo</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateAdvertisement" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="AdName" class="form-label">Tên Quảng Cáo</label>
                            <input asp-for="AdName" class="form-control" />
                            <span asp-validation-for="AdName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Placement" class="form-label">Vị trí (Placement)</label>
                            <select asp-for="Placement" class="form-select" asp-items="@ViewBag.Placements">
                                <option value="">-- Chọn vị trí --</option>
                            </select>
                            <span asp-validation-for="Placement" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdContentUrl" class="form-label">Link Nội dung (Ảnh/Video)</label>
                            <input asp-for="AdContentUrl" class="form-control" placeholder="https://example.com/image.png" />
                            <span asp-validation-for="AdContentUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClickUrl" class="form-label">Link Đích (bấm vào)</label>
                            <input asp-for="ClickUrl" class="form-control" placeholder="/nang-cap" />
                            <span asp-validation-for="ClickUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả (Admin xem)</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label">Thứ tự hiển thị</label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" />
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-center pt-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label">Đang hoạt động?</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <a asp-action="Advertisements" class="btn btn-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary">Lưu Quảng Cáo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>