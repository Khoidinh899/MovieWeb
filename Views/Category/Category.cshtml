@model List<MovieWeb.Models.Entities.Movie>

@{
    Layout = "_Layout";
    var category = ViewBag.Category as MovieWeb.Models.Entities.Category;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string categorySlug = category?.Slug ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/phimbo.css" asp-append-version="true" />
}

<div class="container py-4">

    <!-- 🏷️ Tiêu đề & Bộ lọc -->
    <div class="category-header mb-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center">
        <h2 class="category-title text-white mb-2 mb-sm-0">@category?.Name</h2>
        <div class="filter-section text-white">
            <i class="bi bi-filter me-1"></i> Bộ lọc
        </div>
    </div>

    <!-- 🎬 Danh sách phim -->
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var movie in Model)
            {
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <div class="movie-card">
                        <a href="/phim/@movie.Slug" class="text-decoration-none text-white">
                            <div class="thumb-wrapper">
                                <img src="@(movie.ThumbUrl?.StartsWith("http") == true
                                    ? movie.ThumbUrl
                                    : "https://img.ophim.live/uploads/movies/" + movie.ThumbUrl)"
                                     alt="@movie.Name"
                                     class="movie-thumb" />
                                <div class="overlay">
                                </div>
                            </div>
                            <div class="movie-title">@movie.Name</div>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-white text-center">Không có phim nào trong thể loại này.</p>
        }
    </div>

    <!-- 📌 Phân trang -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/the-loai/@categorySlug?page=@(currentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="/the-loai/@categorySlug?page=@i">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="/the-loai/@categorySlug?page=@(currentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
